---
import { base } from '../../data/base';
import { author } from '../../data/author';
import { mobileNavLinks } from '../../data/navigation';
import ThemeToggle from '../ui/ThemeToggle.astro';
import Pictogram from '../ui/Pictogram.astro';

const currentPath = Astro.url.pathname.slice(base.length) || '/';
const isActive = (href: string) =>
  href === currentPath ||
  (href !== '/' && !href.startsWith('/#') && currentPath.startsWith(href));

const pad = (i: number) => String(i).padStart(2, '0');
const icons = {
  '#favela': 'favela',
  '#robotics': 'robotics',
  '#legible': 'practice',
  '#talks': 'talks',
  '#contact': 'contact',
  '/projects/': 'work',
  '/writing/': 'writing',
} as const;
const entries = mobileNavLinks.map((l, i) => {
  const key = l.href.includes('#') ? l.href.slice(l.href.indexOf('#')) : l.href;
  return { ...l, key, n: pad(i + 1), icon: icons[key as keyof typeof icons] ?? 'about', current: isActive(l.href) };
});

const routeLabels: Record<string, string> = {
  '/': 'home',
  '/projects/': 'projects',
  '/consulting/': 'consulting',
  '/cv/': 'cv',
  '/now/': 'now',
};
const isHome = currentPath === '/';
const routeLabel = currentPath.startsWith('/projects/')
  ? 'work'
  : (routeLabels[currentPath] ?? currentPath.replace(/^\/|\/$/g, '').split('/')[0] ?? 'page');
const here = entries.find((e) => e.current);
const readout = here ? `${here.n} ${routeLabel}` : routeLabel;
---

<header class="site-header" data-header data-open="false">
  <div class="bar">
    <a href={`${base}/`} class="bar-name">{author.name}</a>
    <div class="bar-end">
      <span class="bar-read" aria-hidden="true" data-readout data-home={isHome ? 'true' : undefined}>{readout}</span>
      <ThemeToggle />
      <button type="button" class="bar-mark" aria-controls="site-index" aria-expanded="false" aria-label="Toggle navigation" data-menu>
        <Pictogram name="menu" class="mark-open" />
        <Pictogram name="close" class="mark-close" />
      </button>
    </div>
  </div>
</header>

<div id="site-index" class="index" role="dialog" aria-modal="true" aria-label="Index" data-open="false" inert>
  <button type="button" class="index-close" aria-label="Close menu" data-close>
    <Pictogram name="close" />
  </button>
  <ol>
    {entries.map((e) => (
      <li>
        <a href={base + e.href} class="row" data-key={e.key} {...(e.current ? { 'aria-current': 'page' } : {})}>
          <span class="row-n">{e.n}</span>
          <span class="row-t">{e.label}</span>
          <Pictogram name={e.icon} class="row-i" />
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  :global(:root) {
    --header-clearance: calc(3.1rem + 1px + 0.6rem);
  }

  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--color-bg-primary) 86%, transparent);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--color-border);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header { background-color: var(--color-bg-primary); }
  }
  .site-header::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-accent);
    transform-origin: left;
    transform: scaleX(var(--progress, 0));
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header::after { transition: transform 0.15s linear; }
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.1rem;
    padding: 0 0.5rem 0 1.5rem;
  }
  @media (max-width: 599px) {
    .bar { padding-left: 1rem; }
    .bar-read { display: none; }
  }
  .bar-name {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.98rem;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
  }
  .bar-name:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .bar-end { display: flex; align-items: center; gap: 0.25rem; }
  .bar-read {
    margin-right: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    text-transform: lowercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .bar-mark,
  .index-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .bar-mark:hover,
  .index-close:hover { color: var(--color-text-primary); }
  .bar-mark:focus-visible,
  .index-close:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
  .bar-mark :global(.mark-close) { display: none; }
  .site-header[data-open="true"] .bar-mark :global(.mark-open) { display: none; }
  .site-header[data-open="true"] .bar-mark :global(.mark-close) { display: block; }

  .index {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 1.5rem 2rem;
    background-color: var(--color-bg-primary);
    background-image: radial-gradient(circle, var(--color-text-muted) 0.8px, transparent 1px);
    background-size: 24px 24px;
    background-position: 12px 12px;
  }
  .index[data-open="true"] { display: block; }
  .index::before {
    content: "";
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--color-bg-primary) 90%, transparent);
    pointer-events: none;
  }
  .index-close { position: absolute; top: 0.25rem; right: 0.5rem; }
  .index ol {
    position: relative;
    list-style: none;
    margin: 0 auto;
    padding: 4.5rem 0 0;
    max-width: var(--max-w-content);
  }
  .index li { border-top: 1px solid var(--color-border); }
  .index li:last-child { border-bottom: 1px solid var(--color-border); }
  .row {
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    align-items: center;
    min-height: 4.2rem;
    padding: 0.35rem 0;
    color: var(--color-text-primary);
  }
  .row-n {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  .row-t {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.6rem, 5vw, 2.7rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .row :global(.row-i) { color: var(--color-text-muted); }
  .row:hover .row-t { color: var(--color-accent); }
  .row:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .row[data-on] .row-n,
  .row[aria-current="page"] .row-n,
  .row[data-on] :global(.row-i),
  .row[aria-current="page"] :global(.row-i) { color: var(--color-accent); }

  @media print {
    .index { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const index = document.getElementById('site-index');
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  if (header && index && menu) {
    const root = document.documentElement;
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = root.scrollHeight - window.innerHeight;
      root.style.setProperty('--progress', String(max > 0 ? Math.min(1, window.scrollY / max) : 0));
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();

    const isOpen = () => index.getAttribute('data-open') === 'true';
    const setOpen = (open: boolean) => {
      header.setAttribute('data-open', String(open));
      index.setAttribute('data-open', String(open));
      index.toggleAttribute('inert', !open);
      menu.setAttribute('aria-expanded', String(open));
      for (const el of Array.from(document.body.children)) {
        if (el !== index && el.tagName !== 'SCRIPT') el.toggleAttribute('inert', open);
      }
      if (open) requestAnimationFrame(() => index.querySelector<HTMLElement>('a')?.focus());
      else menu.focus();
    };
    menu.addEventListener('click', () => setOpen(!isOpen()));
    index.querySelector('[data-close]')?.addEventListener('click', () => setOpen(false));
    index.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a.row')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });

    const readout = document.querySelector<HTMLElement>('[data-readout]');
    if (readout?.dataset.home === 'true' && 'IntersectionObserver' in window) {
      const labels: Record<string, string> = {
        home: 'home',
        favela: 'favela research',
        robotics: 'robotics',
        legible: 'practice',
        projects: 'work',
        offer: 'offer',
        about: 'about',
        contact: 'contact',
      };
      const rows = Array.from(index.querySelectorAll<HTMLElement>('a.row'));
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const id = (entry.target as HTMLElement).id;
            const hit = rows.find((r) => r.dataset.key === `#${id}`);
            readout.textContent = `${hit ? `${hit.querySelector('.row-n')?.textContent} ` : ''}${labels[id] ?? id}`;
            for (const r of rows) r.toggleAttribute('data-on', r === hit);
          }
        },
        { rootMargin: '-40% 0px -55% 0px' },
      );
      document.querySelectorAll('main section[id]').forEach((s) => io.observe(s));
    }
  }
</script>
