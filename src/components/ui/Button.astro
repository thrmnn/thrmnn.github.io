---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  external?: boolean;
  id?: string;
  [key: string]: unknown;
}

const { href, variant = 'primary', external = false, id, ...rest } = Astro.props;
const linkProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<a
  href={href}
  id={id}
  class:list={[
    'btn-component inline-flex items-center gap-2 rounded-none font-mono uppercase tracking-[0.12em] transition-colors duration-200',
    variant === 'primary' && 'btn-primary px-5 py-3 text-xs bg-accent text-white hover:text-white hover:bg-accent-hover',
    variant === 'secondary' && 'btn-secondary px-5 py-3 text-xs border border-border-hover text-text-secondary hover:border-accent hover:text-text-primary',
  ]}
  {...linkProps}
  {...rest}
>
  <slot />
  <span class="btn-arrow" aria-hidden="true">&rarr;</span>
</a>

<style>
  .btn-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .btn-component:hover .btn-arrow {
    transform: translateX(3px);
  }

  .btn-secondary {
    background: var(--color-bg-elevated);
  }
</style>
