---
import Picture from './Picture.astro';
const { src, alt, caption, dot = false, width = 1200, height = 1200 } = Astro.props;
---

<figure class="writing-figure">
  <Picture src={src} alt={alt} width={width} height={height} plain={!dot} imgClass="w-full h-auto block" />
  <figcaption>{caption}</figcaption>
</figure>
