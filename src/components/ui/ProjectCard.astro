---
interface Props {
  title: string;
  summary: string;
  href: string;
  label?: string;
  metric?: string;
  year?: number;
  image?: string;
  number: number;
  id?: string;
  index?: number;
}

const { title, summary, href, label, metric, year, image, number, id, index = 0 } = Astro.props;
const plate = String(number).padStart(2, '0');
---

<a
  href={href}
  id={id}
  class="proof-plate"
  data-reveal
  style={`--reveal-d: ${index};`}
>
  <div class="plate-block">
    <span>PLATE {plate}</span>
    <span>{label ?? year}</span>
  </div>
  {image && (
    <div class="plate-figure">
      <img src={image} alt="" width="1200" height="1200" loading="lazy" decoding="async" />
    </div>
  )}
  <div class="plate-body">
    <p class="proof-plate-title">{title}</p>
    <p class="proof-plate-hook">{summary}</p>
    {metric && <div class="plate-foot"><p class="proof-plate-metric">{metric}</p></div>}
  </div>
</a>
