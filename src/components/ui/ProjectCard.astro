---
import Picture from './Picture.astro';
interface Props {
  title: string;
  label?: string;
  metric?: string;
  tags?: string[];
  detail?: string;
  href: string;
  gradient?: string;
  image?: string;
  anim?: string;
  plateName?: string;
  number?: number;
  index?: number;
  reveal?: boolean;
  exploreHref?: string;
  exploreLabel?: string;
}

const { title, label, tags = [], href, gradient, image, anim, plateName, number, index = 0, reveal = true, exploreHref, exploreLabel } = Astro.props;

const isExternal = /^https?:\/\//.test(href);
// Cap at 4 visible tags on hover — the detail page shows the full set.
const hoverTags = tags.slice(0, 4);
---

<div class="relative h-full" {...(reveal ? { 'data-reveal': true } : {})} style={`--reveal-d: ${index}`}>
<a
  href={href}
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener' : undefined}
  class="block group h-full"
>
  <div class="project-card relative overflow-hidden border border-border cursor-pointer transition-colors duration-300 hover:border-border-hover h-full">
    <div class="card-pic">
      {image ? (
        <Picture src={image} anim={anim} width={1200} height={1200} imgClass="card-img" />
      ) : (
        <p class="card-fallback font-mono" aria-hidden="true">{plateName ?? title}</p>
      )}
    </div>
    <div class="p-5">
      {label && (
        <p class="card-label text-[0.7rem] uppercase tracking-[0.18em] text-text-muted mb-1.5 font-medium">
          {label}
        </p>
      )}
      <p class="card-title text-lg font-bold leading-snug text-text-primary" style="font-family: var(--font-display);">
        {title}
      </p>
      {hoverTags.length > 0 && (
        <div class="card-tags flex flex-wrap gap-1.5">
          {hoverTags.map((tag) => (
            <span class="text-[0.62rem] uppercase tracking-[0.12em] text-text-muted border border-border px-2 py-0.5">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>
{exploreHref && (
  <a href={exploreHref} class="explore-entry" aria-label={exploreLabel ?? `Explore ${title}`}>
    Explore
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9l6-6M4 3h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  </a>
)}
</div>

<style>
  .explore-entry {
    position: absolute; top: 12px; right: 12px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px; min-height: 36px; padding: 0 12px;
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: #fff;
    background: rgba(14, 16, 22, 0.72); border: 1px solid rgba(255, 255, 255, 0.28);
    text-decoration: none;
  }
  .explore-entry:hover { border-color: rgba(255, 255, 255, 0.6); }
  .explore-entry:focus-visible { outline: 2px solid #568cf6; outline-offset: 2px; }

  .card-pic { aspect-ratio: 4 / 3; overflow: hidden; border-bottom: 1px solid var(--color-border); }
  .card-pic :global(.card-img) { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; display: block; }
  .card-fallback { margin: 0; padding: 1.5rem; font-size: 1.1rem; font-weight: 700; color: var(--color-text-muted); }

  /* Tags hidden by default — fade and slide in on hover OR keyboard focus.
     On touch / no-hover devices they stay hidden; the detail page carries them. */
  .card-tags {
    margin-top: 0;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.35s var(--ease-out),
      margin-top 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .group:hover .card-tags,
    .project-card:focus-within .card-tags {
      max-height: 4rem;
      margin-top: 0.75rem;
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card-tags { transition: none; }
  }
</style>
