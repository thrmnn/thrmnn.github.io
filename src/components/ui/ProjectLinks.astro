---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import { base } from '../../data/base';

interface Props {
  slugs: string[];
  external?: { label: string; href: string };
}
const { slugs, external } = Astro.props;
const all = await getCollection('projects');
const items = slugs.map((slug) => {
  const p = all.find((e) => e.id === slug || e.id.replace(/\.md$/, '') === slug);
  if (!p) throw new Error(`ProjectLinks: no project "${slug}"`);
  if (!existsSync(`${process.cwd()}/public/projects/${slug}/row.webp`)) {
    throw new Error(`ProjectLinks: no row picture for "${slug}"; run scripts/make-row-thumbs.py`);
  }
  return { href: `${base}/projects/${slug}/`, label: p.data.title, meta: p.data.label, plate: `${base}/projects/${slug}/row.webp` };
});
---

<div class="mx-auto max-w-[var(--max-w-content)] px-6">
  <ul class="entry-rows" data-reveal style="--reveal-d: 3;">
    {items.map((i) => (
      <li><a href={i.href}>
        <span class="entry-plate"><img src={i.plate} alt="" width="176" height="132" loading="lazy" decoding="async" /></span>
        <span class="entry-title">{i.label}</span>
        {i.meta && <span class="entry-meta">{i.meta}</span>}
        <span class="entry-arrow" aria-hidden="true">&rarr;</span>
      </a></li>
    ))}
    {external && (
      <li><a href={external.href} target="_blank" rel="noopener noreferrer">
        <span class="entry-plate entry-plate-out" aria-hidden="true">&nearr;</span>
        <span class="entry-title">{external.label}</span>
        <span class="entry-meta">The practice site</span>
        <span class="entry-arrow" aria-hidden="true">&rarr;</span>
      </a></li>
    )}
  </ul>
</div>
