---
import { getCollection } from 'astro:content';
import { base } from '../../data/base';

interface Props {
  slugs: string[];
  external?: { label: string; href: string };
}
const { slugs, external } = Astro.props;
const all = await getCollection('projects');
const items = slugs.map((slug) => {
  const p = all.find((e) => e.id === slug || e.id.replace(/\.md$/, '') === slug);
  if (!p) throw new Error(`ProjectLinks: no project "${slug}"`);
  return { href: `${base}/projects/${slug}/`, label: p.data.title };
});
---

<div class="mx-auto max-w-[var(--max-w-content)] px-6">
  <ul class="spotlight-links" data-reveal style="--reveal-d: 3;">
    {external && <li><a href={external.href}>{external.label} →</a></li>}
    {items.map((i) => (
      <li><a href={i.href}>{i.label} →</a></li>
    ))}
  </ul>
</div>
