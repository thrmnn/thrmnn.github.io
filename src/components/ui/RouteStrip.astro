---
import {
  minimapPath,
  minimapViewBox,
  minimapSize,
  minimapRadius,
  minimapPlaces,
} from '../../data/minimap';

// Percentage positions so the dots and the ring (plain HTML, not SVG) sit on
// the sphere without SVG-local units; the wrap is square like the viewBox.
const pct = (v: number) => `${((v / minimapSize) * 100).toFixed(2)}%`;
const placeVars = minimapPlaces.map((p) => `--${p.id}-x:${pct(p.x)};--${p.id}-y:${pct(p.y)};`).join('');
---

<!-- The corner map (owner locks L-1 and L-3): full over the hero and the
     places; over the work and below it folds into a labelled tab in the same
     corner and unfolds on the way back. The hero plate lands on Rio here. -->
<div class="route-strip" data-state="full" style={placeVars}>
  <div class="route-body" id="route-body">
    <div class="route-map-wrap">
      <svg class="route-map" viewBox={minimapViewBox} aria-hidden="true" focusable="false">
        <title>Coastlines: Natural Earth, public domain</title>
        <circle class="route-sphere" cx={minimapSize / 2} cy={minimapSize / 2} r={minimapRadius} />
        <path d={minimapPath} />
        {minimapPlaces.map((p) => (
          <a href={`#${p.id}`} tabindex="-1">
            <circle cx={p.x} cy={p.y} r="9" />
          </a>
        ))}
      </svg>
      {minimapPlaces.map((p) => (
        <span class="route-dot" data-dot={p.id} style={`left: var(--${p.id}-x); top: var(--${p.id}-y);`} aria-hidden="true"></span>
      ))}
      <span class="route-ring" aria-hidden="true"></span>
      <span class="route-landing" aria-hidden="true">Vidigal, Rio</span>
    </div>
    <nav class="route-names" aria-label="Jump to a research location">
      {minimapPlaces.map((p) => (
        <a href={`#${p.id}`} class="route-link" data-place={p.id}>{p.name}</a>
      ))}
    </nav>
  </div>
  <button type="button" class="route-tab" aria-controls="route-body" aria-expanded="true" tabindex="-1">Map</button>
</div>

<style>
  .route-strip {
    position: sticky;
    top: var(--header-clearance);
    z-index: 40;
    min-height: 128px;
    max-width: var(--max-w-content);
    margin: 0 auto;
    padding: 0.5rem 1.5rem;
    background-color: color-mix(in srgb, var(--color-bg-primary) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  @media (max-width: 767px) {
    .route-strip {
      min-height: 88px;
      padding: 0.25rem 1rem;
    }
  }
  .route-body {
    display: flex;
    align-items: center;
    gap: 1rem;
    transform-origin: 1.5rem 0.5rem;
  }
  .route-map-wrap {
    position: relative;
    flex: 0 0 auto;
    width: 112px;
    aspect-ratio: 1;
  }
  @media (max-width: 767px) {
    .route-map-wrap { width: 76px; }
    .route-body { gap: 0.6rem; transform-origin: 1rem 0.25rem; }
  }
  .route-map { display: block; width: 100%; height: 100%; overflow: visible; }
  .route-map path {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .route-sphere {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  /* SVG hit areas only; the visible marks are the pixel-sized dots below */
  .route-map circle:not(.route-sphere) { fill: transparent; }
  .route-map a:focus-visible circle { stroke: var(--color-accent); stroke-width: 2; }

  .route-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-text-primary);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .route-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 13px;
    height: 13px;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }
  .route-strip[data-active='rio'] .route-ring { opacity: 1; left: var(--rio-x); top: var(--rio-y); }
  .route-strip[data-active='amsterdam'] .route-ring { opacity: 1; left: var(--amsterdam-x); top: var(--amsterdam-y); }
  .route-strip[data-active='stata'] .route-ring { opacity: 1; left: var(--stata-x); top: var(--stata-y); }

  /* "Vidigal, Rio": said once, beside the dot, when the hero plate lands. */
  .route-landing {
    position: absolute;
    left: calc(var(--rio-x) + 9px);
    top: var(--rio-y);
    transform: translateY(-50%);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--color-text-primary);
    background: var(--color-bg-primary);
    padding: 1px 4px;
    opacity: 0;
    pointer-events: none;
  }
  .route-strip.is-landed .route-landing { animation: route-landing 1.2s var(--ease-out) forwards; }
  @keyframes route-landing {
    0% { opacity: 0; }
    15%, 75% { opacity: 1; }
    100% { opacity: 0; }
  }

  .route-names {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .route-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--dur-1) var(--ease-out);
    white-space: nowrap;
  }
  .route-link:hover { color: var(--color-text-secondary); }
  .route-link[aria-current='location'] { color: var(--color-text-primary); }
  .route-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  @media (max-width: 767px) {
    .route-names {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.7rem;
      scrollbar-width: none;
    }
    .route-names::-webkit-scrollbar { display: none; }
    .route-link { font-size: 0.58rem; letter-spacing: 0.05em; flex-shrink: 0; }
  }
  /* small phones: all three names fit beside the map, open or not (measured at 360) */
  @media (max-width: 419px) {
    .route-names { gap: 0.5rem; }
    .route-link { font-size: 0.55rem; letter-spacing: 0; }
    .route-strip[data-state='open'] { padding-left: 1.9rem; }
  }

  /* Folded: the map shrinks into the corner it came from and the tab takes
     its place. The strip keeps its size in the flow (no layout jump) but
     stops painting a ground, so nothing under it is covered. */
  /* The tab lives in the page's own margin, the thin band no text ever
     enters (24 px on phones, the gutter beside the column on laptops), so
     folded chrome covers nothing (ruling15 principle 5). Fixed, not
     absolute: the strip may sit anywhere, the margin does not move. */
  .route-tab {
    position: fixed;
    left: max(3px, calc((100vw - var(--max-w-content)) / 2 - 26px));
    top: calc(var(--header-clearance) + 0.5rem);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 21px;
    min-height: 68px;
    padding: 0.4rem 0;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: var(--color-bg-primary);
    border: 1px solid var(--color-accent);
    cursor: pointer;
    opacity: 0;
    transform: translateX(-6px);
    pointer-events: none;
  }
  /* a 44 px target without widening the mark into the text column */
  .route-tab::after { content: ''; position: absolute; inset: -10px -12px -10px -3px; }
  .route-tab::before { content: '▸'; writing-mode: horizontal-tb; }
  .route-tab:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .route-strip[data-state='folded'] {
    background-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    pointer-events: none;
  }
  .route-strip[data-state='folded'] .route-body { transform: scale(0.18); opacity: 0; }
  .route-strip[data-state='folded'] .route-tab { opacity: 1; transform: none; pointer-events: auto; }
  .route-strip[data-state='open'] .route-tab { opacity: 1; transform: none; pointer-events: auto; }
  /* backdrop-filter would make the strip the tab's containing block and move it */
  .route-strip[data-state='open'] {
    padding-left: 2.25rem;
    background-color: var(--color-bg-primary);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .route-strip[data-state='open'] .route-tab::before { content: '◂'; }

  @media (prefers-reduced-motion: no-preference) {
    .route-ring {
      transition: left 400ms var(--ease-out), top 400ms var(--ease-out), opacity 200ms var(--ease-out);
    }
    .route-body,
    .route-tab {
      transition: transform 400ms cubic-bezier(0.2, 0.7, 0.2, 1), opacity 400ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .route-strip { transition: background-color 400ms var(--ease-out); }
  }
</style>

<script>
  // One controller for the corner map (ruling15 principle 4): the active place,
  // the fold, and the hero plate's flight all read the same section state.
  import { initHandoff } from '../../scripts/handoff';

  (() => {
    const strip = document.querySelector('.route-strip') as HTMLElement | null;
    if (!strip || !('IntersectionObserver' in window)) return;
    const tab = strip.querySelector('.route-tab') as HTMLButtonElement;
    const body = strip.querySelector('#route-body') as HTMLElement;
    let openedAt = -1;
    const links = new Map(
      Array.from(strip.querySelectorAll<HTMLAnchorElement>('.route-link')).map((a) => [a.dataset.place as string, a]),
    );

    const setActive = (id: string) => {
      strip.dataset.active = id;
      for (const [placeId, link] of links) {
        if (placeId === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    // Beats: the map is full over the hero and the places, folded from the
    // work grid down. A tap on the tab opens it until the next beat.
    const FOLDED_BEATS = new Set(['projects', 'about', 'contact']);
    const PLACE_SECTION: Record<string, string> = { rio: 'research', amsterdam: 'research', stata: 'projects' };
    let beat = 'home';
    const setState = (state: 'full' | 'folded' | 'open') => {
      if (strip.dataset.state === state) return;
      strip.dataset.state = state;
      const tabLive = state !== 'full';
      tab.tabIndex = tabLive ? 0 : -1;
      tab.toggleAttribute('aria-hidden', !tabLive);
      body.inert = state === 'folded';
      openedAt = state === 'open' ? window.scrollY : -1;
      tab.setAttribute('aria-expanded', String(state !== 'folded'));
      tab.setAttribute('aria-label', state === 'folded' ? 'Show the map' : 'Fold the map');
      if (!tabLive) tab.removeAttribute('aria-label');
    };
    tab.addEventListener('click', () => setState(strip.dataset.state === 'open' ? 'folded' : 'open'));
    // An opened map is a glance, not a new resting state: it folds again once
    // the reader scrolls on, so it never sits over the text at rest.
    addEventListener('scroll', () => {
      if (openedAt >= 0 && Math.abs(window.scrollY - openedAt) > 120) setState('folded');
    }, { passive: true });

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          const sectionId = PLACE_SECTION[id] ?? id;
          if (sectionId !== beat) {
            beat = sectionId;
            setState(FOLDED_BEATS.has(beat) ? 'folded' : 'full');
            if (sectionId !== 'research') setActive('');
          }
          if (links.has(id)) setActive(id);
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    for (const id of ['home', 'rio', 'amsterdam', 'research', 'stata', 'projects', 'about', 'contact']) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }

    initHandoff(strip);
  })();
</script>
