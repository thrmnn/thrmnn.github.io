---
import {
  worldStripPath,
  worldStripViewBox,
  worldStripWidth,
  worldStripHeight,
  worldStripPlaces,
} from '../../data/world-strip';

// Percentage positions so the accent ring (plain HTML, not SVG) overlays the
// map without needing SVG-local transform units; the wrap's aspect-ratio
// below is set to the same viewBox ratio so the percentages line up exactly.
const ringVars = worldStripPlaces
  .map((p) => `--${p.id}-x:${((p.x / worldStripWidth) * 100).toFixed(2)}%;--${p.id}-y:${((p.y / worldStripHeight) * 100).toFixed(2)}%;`)
  .join('');
---

<div class="route-strip">
  <div class="route-map-wrap" style={`aspect-ratio: ${worldStripWidth} / ${worldStripHeight};`}>
    <svg class="route-map" viewBox={worldStripViewBox} aria-hidden="true" focusable="false">
      <title>Coastlines: Natural Earth, public domain</title>
      <path d={worldStripPath} />
      {worldStripPlaces.map((p) => (
        <a href={`#${p.id}`} tabindex="-1">
          <circle cx={p.x} cy={p.y} r="4" />
        </a>
      ))}
    </svg>
    {worldStripPlaces.map((p) => (
      <span class="route-dot" style={`left: var(--${p.id}-x); top: var(--${p.id}-y); ${ringVars}`} aria-hidden="true"></span>
    ))}
    <div class="route-ring" style={ringVars} aria-hidden="true"></div>
  </div>
  <nav class="route-names" aria-label="Jump to a research location">
    {worldStripPlaces.map((p) => (
      <a href={`#${p.id}`} class="route-link" data-place={p.id}>{p.name}</a>
    ))}
  </nav>
</div>

<style>
  .route-strip {
    position: sticky;
    top: var(--header-clearance);
    z-index: 40;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 128px;
    padding: 0.5rem 1.5rem;
    max-width: var(--max-w-content);
    margin: 0 auto;
    background-color: color-mix(in srgb, var(--color-bg-primary) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  @media (max-width: 767px) {
    .route-strip {
      min-height: 88px;
      gap: 0.6rem;
      padding: 0.125rem 1rem;
    }
  }
  .route-map-wrap {
    position: relative;
    flex: 0 0 auto;
    height: 112px;
    width: 48px;
  }
  @media (min-width: 768px) {
    .route-map-wrap {
      height: 76px;
      width: 52px;
    }
  }

  .route-map {
    display: block;
    width: 100%;
    height: 100%;
  }
  .route-map path {
    fill: none;
    stroke: var(--color-text-muted);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }
  .route-map circle {
    fill: var(--color-text-muted);
  }
  .route-map a:focus-visible circle {
    fill: var(--color-accent);
  }

  /* the places at rest: a dot in the ink, sized in pixels so it survives any
     map size (an SVG circle in viewBox units vanishes at strip scale) */
  .route-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-text-muted);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .route-ring {
    position: absolute;
    left: 0;
    top: 0;
    width: 10px;
    height: 10px;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    pointer-events: none;
  }
  .route-strip[data-active='rio'] .route-ring { opacity: 1; left: var(--rio-x); top: var(--rio-y); }
  .route-strip[data-active='amsterdam'] .route-ring { opacity: 1; left: var(--amsterdam-x); top: var(--amsterdam-y); }
  .route-strip[data-active='stata'] .route-ring { opacity: 1; left: var(--stata-x); top: var(--stata-y); }
  @media (prefers-reduced-motion: no-preference) {
    /* the places at rest: a dot in the ink, sized in pixels so it survives any
     map size (an SVG circle in viewBox units vanishes at strip scale) */
  .route-dot {
    position: absolute;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-text-muted);
    transform: translate(-50%, -50%);
    pointer-events: none;
  }
  .route-ring {
      transition: left 400ms var(--ease-out), top 400ms var(--ease-out), opacity 200ms var(--ease-out);
    }
  }

  .route-names {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    min-width: 0;
  }
  .route-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--dur-1) var(--ease-out);
    white-space: nowrap;
  }
  .route-link:hover {
    color: var(--color-text-secondary);
  }
  .route-link[aria-current='location'] {
    color: var(--color-text-primary);
  }
  .route-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: 2px;
  }
  @media (max-width: 767px) {
    .route-names {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 0.7rem;
      scrollbar-width: none;
    }
    .route-names::-webkit-scrollbar {
      display: none;
    }
    .route-link {
      font-size: 0.58rem;
      letter-spacing: 0.05em;
      flex-shrink: 0;
    }
  }
</style>

<script>
  // Same instrument pattern as the header readout: one IntersectionObserver,
  // guarded the same way, keyed to the same rootMargin so the strip's active
  // place and the header's live readout agree on when a section is "in view".
  (() => {
    const strip = document.querySelector('.route-strip') as HTMLElement | null;
    if (!strip || !('IntersectionObserver' in window)) return;

    const links = new Map(
      Array.from(strip.querySelectorAll<HTMLAnchorElement>('.route-link')).map((a) => [
        a.dataset.place as string,
        a,
      ]),
    );

    const setActive = (id: string) => {
      strip.dataset.active = id;
      for (const [placeId, link] of links) {
        if (placeId === id) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      }
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    for (const id of ['rio', 'amsterdam', 'stata']) {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    }
  })();
</script>
