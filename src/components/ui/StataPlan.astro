---
import raw from '../../data/stata-plan.json';
import { planSvg, type Plan } from '../../data/stata-plan-svg.ts';
---

<Fragment set:html={planSvg(raw as unknown as Plan)} />

<style is:global>
  .plan { width: 100%; max-width: 30rem; height: auto; display: block; margin: 0 auto; }
  .plan .walls { stroke: var(--text-muted); stroke-opacity: 0.5; stroke-width: 2.2; stroke-linecap: round; fill: none; }
  .plan .was, .plan .said { fill: none; stroke-width: 4; stroke-linecap: round; stroke-linejoin: round; }
  .plan .was { stroke: var(--text-primary); }
  .plan .said { stroke: var(--accent); }
  .plan .was-dot { fill: var(--text-primary); }
  .plan .said-dot { fill: var(--accent); }
  .plan .gap { stroke: var(--text-primary); stroke-width: 1.5; stroke-dasharray: 4 4; }
  .plan .bar { stroke: var(--text-primary); stroke-width: 2; }
  .plan .lab { font: 600 14px 'Space Grotesk', sans-serif; fill: var(--text-primary); paint-order: stroke; stroke: var(--bg-primary); stroke-width: 5px; stroke-linejoin: round; }
  .plan .said-lab { fill: var(--accent); }
  .plan .big { font-size: 22px; font-weight: 700; }
  .plan .tick { font: 12px 'JetBrains Mono', monospace; fill: var(--text-muted); }
</style>
