---
import { base } from '../../data/base';
import { publishedTalks } from '../../data/talks';
import '../../styles/talk-band.css';

const fmt = (iso: string) => new Date(iso).toLocaleDateString('en', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const talks = [...publishedTalks].sort((a, b) => b.date.localeCompare(a.date));
---

{talks.length > 0 && (
  <section id="talks" class="talk-band-section" aria-label="Talks">
    {talks.map((t) => (
      <figure>
        <img src={`${base}${t.photo!.src}`} width={t.photo!.w} height={t.photo!.h} alt={t.photo!.alt} loading="lazy" decoding="async" draggable="false" />
        <figcaption>
          <span>{t.event} · {t.place} · {fmt(t.date)}</span>
          {t.session && <span>{t.session}</span>}
          <span>Photo: {t.photo!.credit}</span>
          {t.href && <a href={t.href} target="_blank" rel="noopener noreferrer">Event page →</a>}
        </figcaption>
      </figure>
    ))}
  </section>
)}
