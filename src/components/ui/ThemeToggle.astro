---
/**
 * ThemeToggle — switches between dark and light mode.
 * Displays the moon icon when the current theme is light (click to go dark)
 * and the sun icon when the current theme is dark (click to go light).
 *
 * Relies on the anti-FOUC inline script in BaseLayout.astro to set
 * `data-theme` on <html> before first paint.
 */
import Pictogram from './Pictogram.astro';
---

<button id="theme-toggle" type="button" aria-label="Toggle dark/light mode" class="theme-toggle">
  <Pictogram name="theme" />
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    border-radius: 0;
    appearance: none;
    -webkit-appearance: none;
    color: var(--color-text-secondary);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--color-text-primary); }
  .theme-toggle:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
</style>

<script>
  function initThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const html = document.documentElement;
      const current = html.getAttribute('data-theme');

      // Determine the effective theme right now (light is default)
      const isDark =
        current === 'dark' ||
        (!current && window.matchMedia('(prefers-color-scheme: dark)').matches);

      const next = isDark ? 'light' : 'dark';

      html.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);

      btn.setAttribute(
        'aria-label',
        next === 'dark' ? 'Switch to light mode' : 'Switch to dark mode',
      );
    });
  }

  initThemeToggle();
</script>
