---
import { base } from '../../data/base';
---

<figure class="track-figure" data-reveal>
  <div class="track-stage">
    <canvas
      data-track-figure
      data-src={`${base}/data/track-figure.json`}
      data-grid={`${base}/data/film-grid.bin`}
      role="img"
      aria-label="Tracked people of a street sequence, each a dot with a short trail, moving through time. Drag across to scrub."
    ></canvas>
  </div>
  <figcaption class="track-caption"><span data-track-count></span> footage <a href="https://motchallenge.net/data/MOT17/" rel="noopener">MOT17</a>, <a href="https://creativecommons.org/licenses/by-nc-sa/3.0/" rel="noopener license">CC BY-NC-SA</a></figcaption>
</figure>

<style>
  .track-figure { margin: 0 0 1.5rem; }
  .track-stage {
    aspect-ratio: 16 / 9;
    border: 1px solid var(--color-border);
    overflow: hidden;
  }
  canvas {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-bg-primary);
    touch-action: pan-y;
    cursor: ew-resize;
  }
  .track-caption {
    margin: 0.6rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }
  [data-track-count]:not(:empty)::after { content: ' \00b7'; }
  .track-caption a { color: inherit; text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 35%, transparent); text-underline-offset: 0.2em; white-space: nowrap; }
</style>

<script>
  import { initTrackFigure } from '../../scripts/track-figure.ts';
  initTrackFigure();
</script>
