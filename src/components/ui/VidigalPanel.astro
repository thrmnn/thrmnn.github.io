---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

// One component for every point-cloud panel on the site. The data file and
// its sidecar are validated against each other at build time so a caption can
// never describe a file that changed underneath it.
interface Props {
  revealDelay?: number;
  data?: string;
  caption?: string;
  provenance?: string;
  ariaLabel?: string;
  aspect?: string;
  mobileAspect?: string;
  emphasis?: number;
  wire?: number;
  zoom?: number;
  splat?: number;
}
const {
  revealDelay = 1,
  data = 'vidigal-rooftops',
  caption = 'Vidigal, Rio de Janeiro · terrain and building footprints',
  provenance = 'MIT Senseable City Lab Rio',
  ariaLabel = 'Oblique point cloud of Vidigal, Rio de Janeiro: a digital terrain model and building footprints.',
  aspect = '1.85 / 1',
  mobileAspect = '1.25 / 1',
  emphasis = 1,
  wire = 0,
  zoom = 1.3,
  splat = 0,
} = Astro.props;

const dataDir = join(process.cwd(), 'public/data');
const meta = JSON.parse(readFileSync(join(dataDir, `${data}.json`), 'utf8')) as { count: number };
const binBytes = readFileSync(join(dataDir, `${data}.bin`)).length;
if (meta.count * 4 !== binBytes) {
  throw new Error(`${data}.json: count (${meta.count}) × 4 does not match ${data}.bin size (${binBytes} bytes)`);
}
---

<section class="artifact-band">
  <div class="hero-artifact vidigal-artifact" data-reveal style={`--reveal-d: ${revealDelay}; --frame-aspect: ${aspect}; --frame-aspect-mobile: ${mobileAspect};`}>
    <div class="artifact-frame vidigal-frame">
      <canvas class="vidigal-panel" data-rooftops={`/data/${data}.bin`} data-emphasis={emphasis} data-wire={wire} data-zoom={zoom} data-splat={splat} aria-label={ariaLabel}></canvas>
      <div class="artifact-corners" aria-hidden="true">
        <span></span><span></span><span></span><span></span>
      </div>
    </div>
    <p class="artifact-caption">{caption}</p>
    <p class="artifact-provenance">{provenance}</p>
  </div>
</section>

<style>
  /* A projected cloud is a diagonal band; a square frame leaves half the box
     empty, so each panel carries its own aspect. */
  .vidigal-artifact {
    max-width: 920px;
  }
  .vidigal-frame {
    aspect-ratio: var(--frame-aspect);
  }
  .vidigal-artifact :global(.artifact-provenance) {
    max-width: 76ch;
    margin-inline: auto;
  }
  .vidigal-panel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 560px) {
    .vidigal-frame { aspect-ratio: var(--frame-aspect-mobile); }
  }
</style>

<script>
  import { initVidigalPanel } from '../../scripts/vidigal-panel.ts';
  document.querySelectorAll<HTMLCanvasElement>('.vidigal-panel').forEach((c) => {
    if (!c.dataset.init) {
      c.dataset.init = '1';
      initVidigalPanel(c);
    }
  });
</script>
