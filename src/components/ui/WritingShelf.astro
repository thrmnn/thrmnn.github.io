---
import { base } from '../../data/base';
import { seriesName } from '../../data/series';
import { getPublishedWriting, formatWritingDate } from '../../data/writing';

const pieces = (await getPublishedWriting()).slice(0, 3);
---

{pieces.length > 0 && (
  <section id="writing" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>Writing</h2>
      <ul class="writing-list" data-reveal style="--reveal-d: 1;">
        {pieces.map((p) => (
          <li>
            <a href={`${base}/writing/${p.id}/`}>{p.data.title}</a>
            <span class="writing-meta">{seriesName(p.data.series)} · {formatWritingDate(p.data.date)}</span>
          </li>
        ))}
      </ul>
      <a href={`${base}/writing/`} class="text-sm mt-6 inline-block text-[var(--color-link)] hover:text-[var(--color-link-hover)]">All writing →</a>
    </div>
  </section>
)}
