---
import { createHash } from 'node:crypto';
import { base } from '../data/base';
import '../styles/global.css';
import { siteConfig } from '../data/site';
import { author } from '../data/author';
import { themeScript, introScript } from '../data/inlineScripts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'profile' | 'article';
  articleJsonLd?: Record<string, unknown>;
}

const { title, description, image, ogType = 'website', articleJsonLd } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;
const canonicalUrl = new URL(Astro.url.pathname.slice(base.length), siteConfig.url).href;
const ogImage = new URL(image || siteConfig.ogImage, siteConfig.url).href;

const socialUrls = author.social
  .filter((s) => s.icon !== 'email')
  .map((s) => s.href);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": author.name,
  "jobTitle": author.role,
  "url": siteConfig.url,
  "image": new URL('/og-default.png', siteConfig.url).href,
  "email": author.email,
  "worksFor": {
    "@type": "Organization",
    "name": author.affiliation,
  },
  "sameAs": socialUrls,
  "alumniOf": [...new Set(author.education.map((edu) => edu.institution))].map((name) => ({
    "@type": "CollegeOrUniversity",
    "name": name,
  })),
  "knowsAbout": [
    "Computer Vision",
    "Perception Systems",
    "Sensor Fusion",
    "LiDAR Processing",
    "3D Reconstruction",
    "Autonomous Navigation",
    "Robot Operating System (ROS)",
    "Deep Learning",
    "Edge Deployment",
    "MLOps",
    "PyTorch",
    "C++",
    "Robot Log Analysis",
    "ROS 2",
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": author.role,
    "occupationLocation": {
      "@type": "Place",
      "name": author.experience[0]?.location,
    },
    "description":
      "Computer vision and MLOps at Roboat (MIT spinoff) as its first intern; research fellow at MIT Senseable City Lab Rio, working on morphometrics of informal urban form; research assistant at EPFL VITA Lab; visiting researcher at IRI (CSIC-UPC).",
  },
};

// Every is:inline script's exact source text, hashed here and rendered
// verbatim from the same constant in inlineScripts.ts — hash and bytes
// can't drift apart. JSON-LD is data, not executed script, so it needs none.
const inlineScriptCsp = [themeScript, introScript]
  .map((s) => `'sha256-${createHash('sha256').update(s).digest('base64')}'`)
  .join(' ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' ${inlineScriptCsp}; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self'`} />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC: set data-theme synchronously before first paint -->
    <script is:inline set:html={themeScript} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={author.name} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href={`${base}/rss.xml`} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}

    <!-- Font (self-hosted Space Grotesk; latin preloaded, latin-ext lazy via unicode-range) -->
    <link rel="preload" href={`${base}/fonts/space-grotesk-latin.woff2`} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <script>
      import { initPointerField } from '../scripts/pointer-field';
      import { initDecompose } from '../scripts/decompose';
      // Deferred so canvas allocation never competes with LCP.
      const startAmbient = () => {
        initPointerField();
        initDecompose();
      };
      'requestIdleCallback' in window
        ? requestIdleCallback(startAmbient, { timeout: 2000 })
        : setTimeout(startAmbient, 1500);

      // Scroll-reveal: resolve [data-reveal] elements into place once, as
      // they enter the viewport. Skipped entirely under reduced-motion.
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('in-view'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
