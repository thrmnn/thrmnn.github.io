---
import '../styles/global.css';
import { siteConfig } from '../data/site';
import { author } from '../data/author';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: 'website' | 'profile' | 'article';
  articleJsonLd?: Record<string, unknown>;
}

const { title, description, image, ogType = 'website', articleJsonLd } = Astro.props;
const pageTitle = title ? `${title} — ${siteConfig.title}` : siteConfig.title;
const pageDescription = description || siteConfig.description;
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.url).href;
const ogImage = new URL(image || siteConfig.ogImage, siteConfig.url).href;

const socialUrls = author.social
  .filter((s) => s.icon !== 'email')
  .map((s) => s.href);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": author.name,
  "jobTitle": author.role,
  "url": siteConfig.url,
  "image": new URL('/avatar.webp', siteConfig.url).href,
  "email": author.email,
  "worksFor": {
    "@type": "Organization",
    "name": author.affiliation,
  },
  "sameAs": socialUrls,
  "alumniOf": [...new Set(author.education.map((edu) => edu.institution))].map((name) => ({
    "@type": "CollegeOrUniversity",
    "name": name,
  })),
  "knowsAbout": [
    "Computer Vision",
    "Perception Systems",
    "Sensor Fusion",
    "LiDAR Processing",
    "3D Reconstruction",
    "Autonomous Navigation",
    "Robot Operating System (ROS)",
    "Deep Learning",
    "Edge Deployment",
    "MLOps",
    "PyTorch",
    "C++",
    "Robot Log Analysis",
    "ROS 2",
  ],
  "hasOccupation": {
    "@type": "Occupation",
    "name": author.role,
    "occupationLocation": {
      "@type": "Place",
      "name": author.experience[0]?.location,
    },
    "description":
      "Perception and autonomy on real robots — first engineering hire (perception) at Roboat (MIT spinoff), through deployment on Amsterdam's canals; research fellow at MIT Senseable City Lab Rio (terrestrial LiDAR-based 3D reconstruction of dense informal settlements); research assistant at EPFL VITA Lab; visiting researcher at IRI (CSIC-UPC).",
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://plausible.io" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC: set data-theme synchronously before first paint -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
        // When no stored preference, let :root / @media (prefers-color-scheme)
        // in CSS handle it — no data-theme attribute needed.
        // Arm the scroll-reveal system (CSS only hides [data-reveal] once set).
        document.documentElement.classList.add('reveal-ready');
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={author.name} />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}

    <!-- Analytics -->
    {import.meta.env.PROD && siteConfig.analytics?.plausible?.enabled && (
      <script
        defer
        data-domain={siteConfig.analytics.plausible.domain}
        src="https://plausible.io/js/script.js"
      />
    )}

    <!-- Font (self-hosted Space Grotesk; latin preloaded, latin-ext lazy via unicode-range) -->
    <link rel="preload" href="/fonts/space-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
    <script>
      import { initPointerField } from '../scripts/pointer-field';
      import { initDecompose } from '../scripts/decompose';
      // Deferred so canvas allocation never competes with LCP.
      const startAmbient = () => {
        initPointerField();
        initDecompose();
      };
      'requestIdleCallback' in window
        ? requestIdleCallback(startAmbient, { timeout: 2000 })
        : setTimeout(startAmbient, 1500);

      // Scroll-reveal: resolve [data-reveal] elements into place once, as
      // they enter the viewport. Skipped entirely under reduced-motion.
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('in-view');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>
