---
import { base } from '../data/base';
import PageLayout from '../layouts/PageLayout.astro';

const pages = [
  {
    label: 'Home',
    href: '/',
    description: 'Bio, featured work, contact',
  },
  {
    label: 'Projects',
    href: '/projects/',
    description: 'Urban form, tree canopy, and the perception work behind them',
  },
  {
    label: 'CV',
    href: '/cv/',
    description: 'Experience, education, skills',
  },
  {
    label: 'Now',
    href: '/now/',
    description: 'What I am working on right now',
  },
];
---

<PageLayout title="404 — Page Not Found" description="This page does not exist.">
  <section class="not-found-section relative min-h-[70vh] flex items-center justify-center overflow-hidden py-[var(--space-section)]">
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6 w-full">
      <div class="text-center mb-12">
                <h1 class="not-found-heading select-none">
          404
        </h1>
        <p class="text-lg sm:text-xl text-text-secondary mt-2 max-w-md mx-auto">
          This page doesn't exist — but these do:
        </p>
      </div>

      <!-- Navigation links -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-3xl mx-auto">
        {pages.map((page) => (
          <a
            href={base + page.href}
            class="not-found-link group block border border-border-hover px-4 sm:px-5 py-4 transition-all duration-200 hover:border-border-hover hover:bg-bg-elevated"
          >
            <span
              class="text-base font-semibold text-text-primary group-hover:text-accent-hover transition-colors"
              style="font-family: var(--font-display);"
            >
              {page.label}
              <span class="inline-block ml-1 opacity-0 -translate-x-1 transition-all duration-200 group-hover:opacity-100 group-hover:translate-x-0">
                &rarr;
              </span>
            </span>
            <span class="block text-sm text-text-muted mt-1">
              {page.description}
            </span>
          </a>
        ))}
      </div>

      <p class="text-center mt-10 text-sm text-text-muted">
        Or go back to the
        <a href={`${base}/`} class="text-[var(--color-link)] hover:text-[var(--color-link-hover)]">
          homepage
        </a>.
      </p>
    </div>
  </section>
</PageLayout>

<style>
  .not-found-heading {
    font-family: var(--font-mono);
    font-size: clamp(5rem, 16vw, 10rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--color-text-muted);
  }

  .not-found-link {
    background: var(--color-bg-elevated);
  }
</style>
