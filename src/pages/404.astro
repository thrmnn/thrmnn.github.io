---
import { base } from '../data/base';
import PageLayout from '../layouts/PageLayout.astro';

const pages = [
  {
    label: 'Home',
    href: '/',
    description: 'Bio, featured work, contact',
  },
  {
    label: 'Projects',
    href: '/projects/',
    description: 'Urban form, tree canopy, and the perception work behind them',
  },
  {
    label: 'CV',
    href: '/cv/',
    description: 'Experience, education, skills',
  },
  {
    label: 'Now',
    href: '/now/',
    description: 'What I am working on right now',
  },
];
---

<PageLayout title="404 — Page Not Found" description="This page does not exist.">
  <section class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h1 class="section-label mb-4">404</h1>
      <p class="research-lead-title">This page doesn't exist — but these do:</p>
      <ul class="entry-rows entry-rows-bare mt-8">
        {pages.map((page) => (
          <li>
            <a href={base + page.href}>
              <span class="entry-title">{page.label}</span>
              <span class="entry-meta">{page.description}</span>
              <span class="entry-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-sm text-text-muted">
        Or go back to the
        <a href={`${base}/`} class="ink-link">homepage</a>.
      </p>
    </div>
  </section>
</PageLayout>
