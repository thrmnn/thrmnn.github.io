---
import PageLayout from '../layouts/PageLayout.astro';
import SectionRule from '../components/composition/SectionRule.astro';
import Marginalia from '../components/composition/Marginalia.astro';
import { author } from '../data/author';
---

<PageLayout title="Contact" description="Email and handles for Théo Alessandro Hermann.">
  <section class="contact grid-cartesian">
    <h1 class="col-1-10 contact-title">
      One email reaches me.<br />
      <a href={`mailto:${author.email}`} class="contact-hero-mail">{author.email}</a>
    </h1>
    <p class="col-3-8 contact-lede">
      For research conversations, consulting at the intersection of built environment and AI
      infrastructure, or anything that resembles either. Replies within a few days.
    </p>

    <div class="col-1-12">
      <SectionRule align="start">Channels</SectionRule>
    </div>

    <dl class="col-1-8 contact-grid">
      <div class="contact-row">
        <dt class="mono-caption">Public</dt>
        <dd><a href={author.links.twitter} rel="me noopener">@{author.handles.public}</a></dd>
      </div>
      <div class="contact-row">
        <dt class="mono-caption">Technical</dt>
        <dd><a href={author.links.github} rel="me noopener">@{author.handles.technical}</a></dd>
      </div>
      <div class="contact-row">
        <dt class="mono-caption">LinkedIn</dt>
        <dd><a href={author.links.linkedin} rel="me noopener">/in/{author.handles.public}</a></dd>
      </div>
      <div class="contact-row">
        <dt class="mono-caption">Based</dt>
        <dd>{author.location}</dd>
      </div>
    </dl>

    <aside class="col-10-12 contact-margin">
      <Marginalia voice="mono">No noisy newsletter. No scheduling links.</Marginalia>
    </aside>
  </section>
</PageLayout>

<style>
  .contact {
    padding-block: clamp(2.5rem, 6vw, 4rem) var(--space-section);
    row-gap: var(--s-6);
  }
  .contact-head {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }
  .contact-title {
    font-family: var(--font-cartesian);
    font-size: var(--text-display-lg);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.025em;
    margin: 0;
  }
  /* The email is the page's one action — it gets the display scale,
     not a table row. */
  .contact-hero-mail {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom: 3px solid var(--color-accent);
    transition: color 200ms ease;
    overflow-wrap: anywhere;
  }
  .contact-hero-mail:hover {
    color: var(--color-accent);
  }
  /* Narrow screens: step the address down one display size so it holds
     one line instead of breaking mid-domain. */
  @media (max-width: 520px) {
    .contact-hero-mail {
      display: inline-block;
      font-size: var(--text-display-sm);
      margin-top: var(--s-2);
      border-bottom-width: 2px;
    }
  }
  .contact-lede {
    font-family: var(--font-body);
    color: var(--color-ink-soft);
    font-size: var(--text-body-lg);
    line-height: 1.55;
    margin: 0;
    margin-top: var(--s-4);
  }
  .contact-grid {
    border-top: 1px solid var(--color-rule);
    margin: 0;
    padding: 0;
  }
  .contact-row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--s-6);
    align-items: baseline;
    padding: var(--s-4) 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .contact-row dt {
    margin: 0;
  }
  .contact-row dd {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--color-ink);
  }
  .contact-row a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 1px;
    text-decoration: none;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }
  .contact-row a:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .contact-margin {
    align-self: end;
    padding-bottom: var(--s-6);
  }
  @media (max-width: 520px) {
    .contact-row {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
