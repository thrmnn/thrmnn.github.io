---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import { author } from '../data/author';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);
const proofProjects = allProjects
  .filter((p) => p.data.featuredOrder !== undefined)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);

const mailto = `mailto:${author.email}`;

// Caption is built from the sidecar at build time so it can never drift from
// the replay data — see scripts/sample-stata-replay.py.
const stataMeta = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-replay.meta.json'), 'utf8'),
) as {
  platform: string;
  dataset: string;
  duration_s: number;
  events: number;
  events_by_detector: { tf_jump: number; covariance_spike: number; pose_divergence: number };
  lost_window: { window: string; position_error_median_m: number; amcl_reported_sigma_median_m: number };
};
const { tf_jump, covariance_spike, pose_divergence } = stataMeta.events_by_detector;
if (tf_jump + covariance_spike + pose_divergence !== stataMeta.events) {
  throw new Error(
    `stata-replay.meta.json: events_by_detector (${tf_jump}+${covariance_spike}+${pose_divergence}) does not sum to events (${stataMeta.events})`,
  );
}
const lostMetres = stataMeta.lost_window.position_error_median_m.toFixed(1);
const lostCm = Math.round(stataMeta.lost_window.amcl_reported_sigma_median_m * 100);
const artifactCaption = `${stataMeta.platform} · ${stataMeta.duration_s} s of a recorded run · ${stataMeta.events} detector events`;
const artifactLegend = `A real robot, replayed from its own logs. Green: where it believed it was. Amber: where my detectors flagged trouble. After a floor change it was ${lostMetres} metres off while reporting ${lostCm} centimetres of uncertainty. Finding that quiet kind of failure is the work.`;
---

<PageLayout ogType="profile">
  <!-- Hero — type-first viewport 1; the artifact band follows below -->
  <section id="home" class="hero-section">
    <div class="hero-type">
      <h1
        class="hero-name"
        data-decompose
        data-reveal
        style="--reveal-d: 0;"
      >
        {author.name}
      </h1>
      <p class="hero-positioning" data-reveal style="--reveal-d: 1;">
        Robotics engineer. I ship perception and autonomy on real robots, reconstruct dense cities from terrestrial LiDAR, and measure tree canopy from the air. Four years on real hardware: first engineering hire and perception lead through deployment at <strong>Roboat</strong>.
      </p>
      <p class="hero-caption" data-reveal style="--reveal-d: 2;">
        Robot navigation log triage for fleets has its own page: <a href="https://theohermann.ch">theohermann.ch</a>.
      </p>
      <div class="hero-cta-row" data-reveal style="--reveal-d: 3;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
    </div>
  </section>

  <!-- Artifact band — full-width, centered; replay of a real recorded robot run -->
  <section class="artifact-band">
    <div class="hero-artifact" data-reveal style="--reveal-d: 1;">
      <div class="artifact-frame">
        <canvas
          class="favela-scrubber"
          data-walls="/data/stata-walls.bin"
          data-replay="/data/stata-replay.json"
          aria-label="Replay of a recorded PR2 run in the MIT Stata Center: wall map, the robot's estimated path, and the moments a fault detector fired."
        ></canvas>
        <div class="artifact-corners" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>
      <p class="artifact-caption">{artifactCaption}</p>
      <p class="artifact-legend">{artifactLegend}</p>
      <p class="artifact-provenance">
        recorded data: MIT Stata Center dataset (CC BY 3.0) · detections: <a href="https://github.com/thrmnn/ros2-localization-triage">ros2-localization-triage</a> — open source, every number recomputable · the consulting practice built on it: <a href="https://theohermann.ch">theohermann.ch</a>
      </p>
    </div>
  </section>

  <!-- Proof — static grid, no carousel -->
  <section id="projects" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>Selected work</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {proofProjects.map((p, i) => (
          <a
            href={`/projects/${p.id}/`}
            class="proof-plate"
            data-reveal
            style={`--reveal-d: ${i + 1};`}
          >
            {p.data.label && <p class="proof-plate-label">{p.data.label}</p>}
            <p class="proof-plate-title">{p.data.title}</p>
            <p class="proof-plate-hook">{p.data.summary}</p>
          </a>
        ))}
      </div>
      <p class="mt-8">
        <a href="/projects/" class="text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)]">All work →</a>
      </p>
    </div>
  </section>

  <!-- Territory strip -->
  <section id="territory" class="py-[var(--space-block)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <p class="territory-strip" data-reveal>
        robot data, logs &amp; telemetry · perception &amp; sensor fusion · SLAM &amp; state estimation (ROS/ROS 2) · 3D/LiDAR pipelines · urban 3D reconstruction (terrestrial LiDAR, Rio) · tree canopy &amp; LAI (aerial LiDAR, Amsterdam) · edge deployment (Jetson, TensorRT) · AI agents for engineering workflows
      </p>
    </div>
  </section>

  <!-- Biography -->
  <section id="about" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="shrink-0 mx-auto md:mx-0" data-reveal style="--reveal-d: 1;">
        <div class="avatar-ring rounded-full p-[3px]">
          <img
            src="/avatar.webp"
            alt={author.name}
            width="180"
            height="180"
            loading="eager"
            decoding="async"
            class="rounded-full block"
          />
        </div>
        <div class="mt-4 text-center md:text-left">
          <p class="text-xl font-bold text-text-primary">{author.name}</p>
          <p class="text-sm text-text-muted">{author.role}</p>
        </div>
        <div class="flex gap-3 mt-4 justify-center md:justify-start">
          {author.social.map((s) => (
            <a
              href={s.href}
              {...(s.icon !== 'email' ? { target: '_blank', rel: 'noopener' } : {})}
              class="text-text-muted hover:text-text-secondary transition-colors"
              aria-label={s.label}
              title={s.label}
            >
              <SocialIcon type={s.icon as 'email' | 'github' | 'linkedin' | 'scholar'} />
            </a>
          ))}
        </div>
      </div>
      <div class="flex-1 max-w-prose" data-reveal style="--reveal-d: 2;">
        {author.bio.map((paragraph) => (
          <p class="text-text-secondary leading-relaxed mb-4" set:html={paragraph} />
        ))}
        <p class="mt-2">
          <a href="/cv/" class="text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">Full CV →</a>
        </p>
      </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="contact-bg absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-accent mb-4" data-reveal>Get in touch.</h2>
      <p class="text-text-secondary mb-10 max-w-lg mx-auto text-lg" data-reveal style="--reveal-d: 1;">
        Research collaborations, questions about the work on this page, or anything robotics: write two lines.
      </p>
      <div class="flex justify-center gap-3 sm:gap-5 flex-wrap" data-reveal style="--reveal-d: 2;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { initFavelaScrubber } from '../scripts/favela-scrubber.ts';
    const canvas = document.querySelector('.favela-scrubber') as HTMLCanvasElement | null;
    if (canvas) initFavelaScrubber(canvas);
  </script>
</PageLayout>
