---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import { author } from '../data/author';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);
const proofProjects = allProjects
  .filter((p) => p.data.featuredOrder !== undefined)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);

const mailto = `mailto:${author.email}`;
const calLink = 'https://cal.com/theo-hermann-aaa7tm';

// Caption is built from the sidecar at build time so it can never drift from
// the replay data — see scripts/sample-stata-replay.py.
const stataMeta = JSON.parse(
  readFileSync(join(process.cwd(), 'public/data/stata-replay.meta.json'), 'utf8'),
) as {
  platform: string;
  dataset: string;
  duration_s: number;
  events: number;
};
const artifactCaption = `${stataMeta.platform} · ${stataMeta.dataset} · ${stataMeta.duration_s} s AMCL replay · ${stataMeta.events} detector events`;
---

<PageLayout ogType="profile">
  <!-- Hero — type-first viewport 1; the artifact band follows below -->
  <section id="home" class="hero-section">
    <div class="hero-type">
      <h1
        class="hero-name"
        data-decompose
        data-reveal
        style="--reveal-d: 0;"
      >
        {author.name}
      </h1>
      <p class="hero-positioning" data-reveal style="--reveal-d: 1;">
        Independent robotics engineer. I take on perception, autonomy, and robot-data problems for teams running real robots. Four years in perception and autonomy, shipped on real hardware at <strong>Roboat</strong> (first engineering hire, perception lead through deployment), <strong>EPFL VITA Lab</strong> and <strong>IRI Barcelona</strong>.
      </p>
      <p class="hero-caption" data-reveal style="--reveal-d: 2;">
        Free 20-minute call, then a written, fixed-scope, fixed-price proposal if it fits.
      </p>
      <div class="hero-cta-row" data-reveal style="--reveal-d: 3;">
        <Button href={calLink} external>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Book a 20-min intro
        </Button>
        <Button href={mailto} variant="secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
    </div>
  </section>

  <!-- Artifact band — full-width, centered; replay of a real recorded robot run -->
  <section class="artifact-band">
    <div class="hero-artifact" data-reveal style="--reveal-d: 1;">
      <div class="artifact-frame">
        <canvas
          class="favela-scrubber"
          data-walls="/data/stata-walls.bin"
          data-replay="/data/stata-replay.json"
          aria-label="Replay of a recorded PR2 localization run in the MIT Stata Center: wall map, robot trajectory, and the moments a fault detector fired."
        ></canvas>
        <div class="artifact-corners" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
        </div>
      </div>
      <p class="artifact-caption">{artifactCaption}</p>
      <p class="artifact-provenance">
        recorded data: MIT Stata Center dataset (CC BY 3.0) · detections: <a href="https://github.com/thrmnn/ros2-localization-triage">ros2-localization-triage</a>
      </p>
    </div>
  </section>

  <!-- Proof — static grid, no carousel -->
  <section id="projects" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>Selected work</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {proofProjects.map((p, i) => (
          <a
            href={`/projects/${p.id}/`}
            class="proof-plate"
            data-reveal
            style={`--reveal-d: ${i + 1};`}
          >
            {p.data.label && <p class="proof-plate-label">{p.data.label}</p>}
            <p class="proof-plate-title">{p.data.title}</p>
            <p class="proof-plate-hook">{p.data.summary}</p>
          </a>
        ))}
      </div>
      <p class="mt-8">
        <a href="/projects/" class="text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)]">All work →</a>
      </p>
    </div>
  </section>

  <!-- Offer -->
  <section id="offer" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>How I work</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div data-reveal style="--reveal-d: 1;">
          <p class="offer-lead">Investigate</p>
          <p class="text-text-secondary leading-relaxed">Find where the real bottleneck is: logs, bags, code, or latency. An incident report with a reconstructed timeline, root cause, and the supporting evidence from your own bags and logs.</p>
        </div>
        <div data-reveal style="--reveal-d: 2;">
          <p class="offer-lead">Prototype</p>
          <p class="text-text-secondary leading-relaxed">A working experiment, scoped to one question, run on your data or your robot.</p>
        </div>
        <div data-reveal style="--reveal-d: 3;">
          <p class="offer-lead">Improve</p>
          <p class="text-text-secondary leading-relaxed">Turn what worked into infrastructure your team keeps: calibrated detectors, reproducible pipelines, a test suite that catches regressions before they ship.</p>
        </div>
      </div>
      <p class="mt-10" data-reveal style="--reveal-d: 4;">
        <a href="/consulting/" class="text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">See how these become scoped engagements →</a>
      </p>
    </div>
  </section>

  <!-- Territory strip -->
  <section id="territory" class="py-[var(--space-block)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <p class="territory-strip" data-reveal>
        robot data, logs &amp; telemetry · perception &amp; sensor fusion · SLAM &amp; state estimation (ROS/ROS 2) · 3D/LiDAR pipelines · edge deployment (Jetson, TensorRT) · AI agents for engineering workflows
      </p>
    </div>
  </section>

  <!-- Where this is going -->
  <section id="direction" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6 max-w-prose">
      <h2 class="text-2xl md:text-3xl font-bold text-text-primary mb-6" data-reveal>Where this is going</h2>
      <p class="text-text-secondary leading-relaxed mb-4" data-reveal style="--reveal-d: 1;">
        The same failure-detector thresholds that stay quiet on one robot platform can false-alarm from 9 to 1,880 times an hour on another. That gap — not detection itself — is the actual work, and it's the direction I'm building toward: tooling that makes robot operational data usable across a fleet, not just on one machine.
      </p>
      <p class="text-text-secondary leading-relaxed" data-reveal style="--reveal-d: 2;">
        The rigor bar for that direction is set by <a href="https://github.com/thrmnn/ros2-localization-triage" class="text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">ros2-localization-triage</a>, a public methodology for exactly this problem: four fault detectors, evaluated against 108 minutes of real recordings from five robot platforms, every number recomputable from the repo — published under my own name. That's cross-platform validation, not a live customer fleet; the per-fleet calibration work is what an engagement would build. No product or customers under a separate name yet.
      </p>
    </div>
  </section>

  <!-- Biography -->
  <section id="about" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="shrink-0 mx-auto md:mx-0" data-reveal style="--reveal-d: 1;">
        <div class="avatar-ring rounded-full p-[3px]">
          <img
            src="/avatar.webp"
            alt={author.name}
            width="180"
            height="180"
            loading="eager"
            decoding="async"
            class="rounded-full block"
          />
        </div>
        <div class="mt-4 text-center md:text-left">
          <p class="text-xl font-bold text-text-primary">{author.name}</p>
          <p class="text-sm text-text-muted">{author.role}</p>
        </div>
        <div class="flex gap-3 mt-4 justify-center md:justify-start">
          {author.social.map((s) => (
            <a
              href={s.href}
              {...(s.icon !== 'email' ? { target: '_blank', rel: 'noopener' } : {})}
              class="text-text-muted hover:text-text-secondary transition-colors"
              aria-label={s.label}
              title={s.label}
            >
              <SocialIcon type={s.icon as 'email' | 'github' | 'linkedin' | 'scholar'} />
            </a>
          ))}
        </div>
      </div>
      <div class="flex-1 max-w-prose" data-reveal style="--reveal-d: 2;">
        {author.bio.map((paragraph) => (
          <p class="text-text-secondary leading-relaxed mb-4" set:html={paragraph} />
        ))}
        <p class="mt-2">
          <a href="/cv/" class="text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">Full CV →</a>
        </p>
      </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="contact-bg absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-accent mb-4" data-reveal>Let's talk.</h2>
      <p class="text-text-secondary mb-10 max-w-lg mx-auto text-lg" data-reveal style="--reveal-d: 2;">
        Have a robot problem — perception, autonomy, robot data, an eval that won't hold up? Write with two lines about it. Free 20-minute call, then a written, fixed-scope, fixed-price proposal if it's a fit. Weekly written updates. A clean handover: running code, documentation, a written report. Analysis runs on your infrastructure or under NDA on mine; nothing is retained after handover.
      </p>
      <div class="flex justify-center gap-3 sm:gap-5 flex-wrap" data-reveal style="--reveal-d: 3;">
        <Button href={calLink} external>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          Book a 20-min intro
        </Button>
        <Button href={mailto} variant="secondary">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
    </div>
  </section>

  <script>
    import { initFavelaScrubber } from '../scripts/favela-scrubber.ts';
    const canvas = document.querySelector('.favela-scrubber') as HTMLCanvasElement | null;
    if (canvas) initFavelaScrubber(canvas);
  </script>
</PageLayout>
