---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import VidigalPanel from '../components/ui/VidigalPanel.astro';
import { author } from '../data/author';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).filter((p) => !p.data.draft);
const proofProjects = allProjects
  .filter((p) => p.data.featuredOrder !== undefined)
  .sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!);

const mailto = `mailto:${author.email}`;

---

<PageLayout ogType="profile">
  <!-- Hero — type-first viewport 1; the research artifact follows below -->
  <section id="home" class="hero-section">
    <div class="hero-type">
      <h1
        class="hero-name"
        data-decompose
        data-reveal
        style="--reveal-d: 0;"
      >
        {author.name}
      </h1>
      <p class="hero-positioning" data-reveal style="--reveal-d: 1;">
        Researcher and engineer. I measure environments that resist measurement: cities built without plans, tree canopy across a whole city, robots that have to know where they are. Different fields, one problem. Turning raw sensing into a number someone can defend.<br /><span class="hero-credentials">MSc Robotics, EPFL. Research fellow at <a href="https://senseablerio.mit.edu/" class="hero-credentials-link">MIT Senseable City Lab Rio</a>; earlier, computer vision and MLOps at Roboat.</span>
      </p>
      <div class="hero-cta-row" data-reveal style="--reveal-d: 2;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
    </div>
  </section>

  <!-- Research — one lead strand carried by the artifact, two named after it.
       Method and affiliation only: the studies are unpublished and multi-author,
       so no result, figure or finding appears here. -->
  <section id="research" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <p class="research-place" data-reveal style="--reveal-d: 1;">Rio de Janeiro</p>
      <h3 class="research-lead-title" data-reveal style="--reveal-d: 2;">A city that was never drawn.</h3>
      <p class="research-lead-body" data-reveal style="--reveal-d: 3;">Favelas are built without plans, and the usual urban measurements assume a street grid that is not there. I build morphometrics for that fabric from terrain models and building footprints: sky openness, frontal area density, slope, porosity, on a grid fine enough to describe a single alley. The wind and sunlight simulations run on those measurements.</p>
    </div>
    <VidigalPanel revealDelay={4} />
    <div class="mx-auto max-w-[var(--max-w-content)] px-6 research-second">
      <p class="research-place" data-reveal style="--reveal-d: 1;">Amsterdam</p>
      <h3 class="research-lead-title" data-reveal style="--reveal-d: 2;">Trees the city already scanned.</h3>
      <p class="research-lead-body" data-reveal style="--reveal-d: 3;">Cities fly aerial LiDAR surveys on a regular cycle for unrelated reasons. In that data, a pulse that passes through a crown and a pulse the crown intercepts are distinguishable, so the fraction of sky visible through each tree can be recovered from a scan that already exists. Leaf area then follows by a physical inversion with stated assumptions, not a fitted model.</p>
    </div>
    <VidigalPanel
      revealDelay={4}
      data="amsterdam-canopy"
      emphasis={1.2}
      splat={0.015}
      tilt={0.95}
      swing={0.45}
      zoom={1.3}
      caption="Jordaan, Amsterdam · a canal, its houses and its trees"
      provenance="AHN5, the Dutch national airborne laser scan, open data · Senseable City Lab, MIT and AMS Institute"
      ariaLabel="Oblique point cloud of a canal in the Jordaan, Amsterdam: ground, roofs and tree crowns from an airborne laser scan; the water returns nothing and shows as a gap."
    />
  </section>

  <!-- Proof — static grid, no carousel -->
  <section id="projects" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>Selected work</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {proofProjects.map((p, i) => (
          <a
            href={`/projects/${p.id}/`}
            class="proof-plate"
            data-reveal
            style={`--reveal-d: ${i + 1};`}
          >
            {p.data.label && <p class="proof-plate-label">{p.data.label}</p>}
            <p class="proof-plate-title">{p.data.title}</p>
            <p class="proof-plate-hook">{p.data.summary}</p>
            {p.data.metric && <p class="proof-plate-metric">{p.data.metric}</p>}
          </a>
        ))}
      </div>
      <p class="mt-8">
        <a href="/projects/" class="text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)]">All work →</a>
      </p>
    </div>
  </section>


  <!-- Biography -->
  <section id="about" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="shrink-0 mx-auto md:mx-0" data-reveal style="--reveal-d: 1;">
        <div class="avatar-mark">
          <canvas
            class="monogram-avatar"
            data-monogram={author.monogram.replace(/[^A-Za-z]/g, '')}
            width="180"
            height="180"
            aria-hidden="true"
          ></canvas>
        </div>
        <div class="mt-4 text-center md:text-left">
          <p class="text-xl font-bold text-text-primary">{author.name}</p>
          <p class="text-sm text-text-muted">{author.role}</p>
        </div>
        <div class="flex gap-3 mt-4 justify-center md:justify-start">
          {author.social.map((s) => (
            <a
              href={s.href}
              {...(s.icon !== 'email' ? { target: '_blank', rel: 'noopener' } : {})}
              class="text-text-muted hover:text-text-secondary transition-colors"
              aria-label={s.label}
              title={s.label}
            >
              <SocialIcon type={s.icon as 'email' | 'github' | 'linkedin' | 'scholar'} />
            </a>
          ))}
        </div>
      </div>
      <div class="flex-1 max-w-prose" data-reveal style="--reveal-d: 2;">
        {author.bio.map((paragraph) => (
          <p class="text-text-secondary leading-relaxed mb-4" set:html={paragraph} />
        ))}
        <p class="mt-2">
          <a href="/cv/" class="inline-block py-3 -my-3 text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">Full CV →</a>
        </p>
      </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="contact-bg absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-accent mb-4" data-reveal>Get in touch.</h2>
      <p class="text-text-secondary mb-10 max-w-lg mx-auto text-lg" data-reveal style="--reveal-d: 1;">
        Research collaborations, or questions about the work on this page: write two lines.
      </p>
      <div class="flex justify-center gap-3 sm:gap-5 flex-wrap" data-reveal style="--reveal-d: 2;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
    </div>
  </section>


  <script>
    import { initMonogramAvatar } from '../scripts/monogram-avatar.ts';
    const avatar = document.querySelector('.monogram-avatar') as HTMLCanvasElement | null;
    if (avatar) initMonogramAvatar(avatar);
  </script>
</PageLayout>
