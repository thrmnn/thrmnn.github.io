---
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import HeroFigure from '../components/ui/HeroFigure.astro';
import HomeCards from '../components/ui/HomeCards.astro';
import HomeProjects from '../components/ui/HomeProjects.astro';
import AboutBlock from '../components/ui/AboutBlock.astro';
import WritingShelf from '../components/ui/WritingShelf.astro';
import { author } from '../data/author';
import { practiceUrl } from '../data/cards';
import { contactDoors } from '../data/home';
import { talk } from '../data/talk';

const mailto = `mailto:${author.email}`;
const cards = [
  { slug: 'autonomous-boat-perception', src: '/projects/autonomous-boat-perception/hero-tile.webp', anim: '/projects/autonomous-boat-perception/hero-tile-anim.webp', phone: '/projects/autonomous-boat-perception/hero-tile-phone.webp', animPhone: '/projects/autonomous-boat-perception/hero-tile-phone-anim.webp', pos: '50% 0%', w: 600, h: 600, alt: 'A small boat on an Amsterdam canal with a simulated lidar scan, drawn as dots.' },
  { slug: 'urban-morphometrics', src: '/projects/urban-morphometrics/vidigal-plate.webp', phone: '/projects/urban-morphometrics/vidigal-tile.webp', anim: '/projects/urban-morphometrics/vidigal-hero-anim.webp', animPhone: '/projects/urban-morphometrics/vidigal-tile-anim.webp', w: 1200, h: 1200, alt: 'Vidigal, Rio de Janeiro: the hillside as contour lines of dots, the buildings in blue.' },
  { slug: 'ros2-localization-triage', src: '/projects/ros2-localization-triage/decipher-tile.webp', anim: '/projects/ros2-localization-triage/decipher-tile-anim.webp', w: 600, h: 600, alt: 'A logistics robot drawn in dots inside the MIT Stata Center laser map, and a second orange robot far from it, where its localization said it was.' },
];
---

<PageLayout ogType="profile">
  <section id="home" class="hero-section hero-section--figure">
    <HeroFigure />
    <p class="hero-name-top">{author.name}</p>
    <div class="hero-grid">
      <div class="hero-type">
        <h1 class="hero-name" data-decompose data-reveal style="--reveal-d: 0;">{author.headline}</h1>
        <p class="hero-positioning" data-reveal style="--reveal-d: 1;">{author.subtitle}</p>
        <p class="hero-lines" data-reveal style="--reveal-d: 1;"><span class="hero-now">{author.heroLines[0]}</span></p>
        {talk && (
          <a href={talk.href} class="talk-band" data-reveal style="--reveal-d: 2;">
            <span class="talk-band-kind">Speaking</span>
            <span>{talk.event}, <span class="talk-band-when">{talk.when}</span></span>
            <span class="talk-band-arrow" aria-hidden="true">&rarr;</span>
          </a>
        )}
        <div class="hero-cta-row" data-reveal style="--reveal-d: 3;">
          <Button href={mailto}>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            E-mail
          </Button>
          <Button href={practiceUrl} variant="secondary">For robot makers</Button>
        </div>
      </div>
    </div>
  </section>

  <HomeCards cards={cards} />
  <HomeProjects skip={cards.map((c) => c.slug)} />
  <WritingShelf />
  <AboutBlock />

  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="text-4xl md:text-5xl font-bold text-text-primary mb-4" data-reveal>Get in touch.</h2>
      <p class="text-text-secondary mb-10 max-w-lg text-lg" data-reveal style="--reveal-d: 1;">
        {contactDoors.intro}
      </p>
      <div class="flex gap-3 sm:gap-5 flex-wrap" data-reveal style="--reveal-d: 2;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          {contactDoors.research}
        </Button>
        <Button href={practiceUrl} variant="secondary" external>{contactDoors.practice}</Button>
      </div>
      <p class="contact-address" data-reveal style="--reveal-d: 3;">{author.email}</p>
    </div>
  </section>

  <script>
    // Remember which homepage block a project link was clicked in, so the
    // project page can offer "Back" to it. sessionStorage only; no query string.
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest('a[href*="/projects/"]') as HTMLAnchorElement | null;
      const sec = a?.closest('main section[id]');
      const m = a?.pathname.match(/\/projects\/([^/]+)\/?$/);
      if (!a || !sec || !m || !['highlights', 'projects'].includes(sec.id)) return;
      try {
        sessionStorage.setItem('back-from', JSON.stringify({ id: sec.id, slug: m[1] }));
      } catch {}
    });
  </script>
</PageLayout>
