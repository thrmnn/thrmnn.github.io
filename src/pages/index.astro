---
import PageLayout from '../layouts/PageLayout.astro';
import FeaturedStrip from '../components/FeaturedStrip.astro';
import Marginalia from '../components/composition/Marginalia.astro';
import SectionRule from '../components/composition/SectionRule.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../data/site';

const writingAll = await getCollection('writing');
const latestWriting = writingAll
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 1)[0];

const projectCount = (await getCollection('projects')).filter((p) => p.data.featured).length;
const scrollLabel = `↓ CURRENT WORK · ${String(projectCount).padStart(2, '0')} PROJECT${projectCount === 1 ? '' : 'S'}`;
---

<PageLayout description={siteConfig.description}>
  <section class="hero">
    <div class="hero-grid grid-cartesian">
      <div class="hero-statement-wrap col-1-12">
        <h1 class="hero-statement">
          <span class="hs-cartesian">I build AI systems</span>
          <span class="hs-connective">that survive contact with</span>
          <em class="hs-tropical">the real world.</em>
        </h1>
      </div>
      <aside class="hero-meta col-10-12">
        <hr class="hero-rule" />
        <p class="hero-positioning">
          Théo Alessandro Hermann.<br />
          Robotics &amp; ML engineer —<br />
          MIT Senseable City Lab, EPFL.<br />
          Perception and RAG pipelines, in production.
        </p>
        <hr class="hero-rule" />
        <p class="mono-caption"><a href="/work">SEE THE WORK</a> · <a href="/contact">WORK WITH ME</a></p>
      </aside>
    </div>
    <p class="hero-scroll mono-caption">{scrollLabel}</p>
  </section>

  <div class="page-wrap below-hero">
    <FeaturedStrip />

    {
      latestWriting && (
        <section class="writing-section">
          <SectionRule>Writing</SectionRule>
          <div class="grid-cartesian writing-grid">
            <a href={`/writing/${latestWriting.id}`} class="writing-card col-1-8">
              <span class="mono-caption">
                {latestWriting.data.date.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
              <h3 class="writing-title">{latestWriting.data.title}</h3>
              <p class="writing-summary">{latestWriting.data.summary}</p>
            </a>
            <aside class="col-10-12 writing-meta">
              <Marginalia voice="mono">Notes & essays — irregular cadence</Marginalia>
            </aside>
          </div>
        </section>
      )
    }
  </div>
</PageLayout>

<style>
  /* Hero — 100vh asymmetric composition (Phase 4.7 A3).
     90vh leaves a sliver of the next section visible at the bottom,
     hinting at scroll without showing actual content. */
  .hero {
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding-block: var(--s-16);
    position: relative;
  }
  .hero-grid {
    width: 100%;
    align-items: start;
    padding-top: 8vh;
  }
  .hero-wordmark {
    /* Wordmark breathes at top of viewport; no extra padding. */
  }
  .hero-meta {
    /* Second grid row, cols 10–12 — sits low-right of the statement,
       keeping the asymmetric composition. */
    padding-top: var(--s-8);
  }
  .hero-rule {
    border: 0;
    border-top: 1px solid var(--color-rule);
    margin: var(--s-4) 0;
  }
  .hero-positioning {
    font-family: var(--font-body);
    font-size: var(--text-body-lg);
    line-height: 1.45;
    color: var(--color-ink-soft);
    margin-block: var(--s-4);
  }
  .hero-scroll {
    text-align: left;
    color: var(--color-ink-muted);
    padding-bottom: var(--s-4);
    padding-inline: 1.5rem;
    margin: 0;
  }
  @media (min-width: 768px) {
    .hero-scroll {
      padding-inline: 2.5rem;
    }
  }
  @media (max-width: 719px) {
    .hero {
      min-height: 80vh;
      padding-block: var(--s-12);
    }
    .hero-grid {
      padding-top: var(--s-12);
    }
    .hero-meta {
      padding-top: var(--s-8);
    }
  }

  /* Hero statement — THE typographic moment. The locked thesis (§2) set
     as the two registers colliding in one sentence: Space Grotesk for the
     Cartesian half, Fraunces italic for the Tropical half. The name lives
     in the header wordmark; the statement is what a stranger should leave
     with. (§6: no big-typography name hero.) */
  .hero-statement {
    font-size: var(--text-hero);
    line-height: 0.98;
    color: var(--color-ink);
    margin: 0;
    font-weight: 500;
  }
  /* Each line is a block so its line box sizes to its own type — an
     inline connective inherits the h1's ~1em strut and opens a lopsided
     gap above itself. */
  .hero-statement > span,
  .hero-statement > em {
    display: block;
  }
  .hs-cartesian {
    font-family: var(--font-cartesian);
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .hs-connective {
    font-family: var(--font-cartesian);
    font-weight: 300;
    font-size: var(--text-display-md);
    letter-spacing: 0.01em;
    color: var(--color-ink-muted);
    margin-block: 0.3em;
  }
  .hs-tropical {
    font-family: var(--font-tropical);
    font-style: italic;
    font-weight: 420;
    letter-spacing: -0.015em;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 100,
      'WONK' 1;
  }

  /* Below-fold sections — sit below the hero, only visible once scrolled. */
  .below-hero {
    margin-top: var(--space-section);
  }

  .writing-section {
    margin-top: var(--space-section);
  }
  .writing-grid {
    padding-inline: 0;
    max-width: none;
  }

  .writing-card {
    display: block;
    text-decoration: none;
    padding: var(--s-4) 0;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink);
    transition: border-color 250ms ease;
  }
  .writing-card:hover {
    border-color: var(--color-rule-strong);
  }
  .writing-title {
    font-family: var(--font-cartesian);
    font-size: var(--text-display-sm);
    font-weight: 600;
    margin-top: var(--s-2);
    letter-spacing: -0.015em;
  }
  .writing-card:hover .writing-title {
    color: var(--color-accent);
  }
  .writing-summary {
    color: var(--color-ink-muted);
    margin-top: var(--s-2);
    max-width: 62ch;
    font-size: var(--text-body-sm);
  }
  .writing-meta {
    align-self: center;
  }
</style>
