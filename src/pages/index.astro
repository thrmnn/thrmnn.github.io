---
import { base } from '../data/base';
import PageLayout from '../layouts/PageLayout.astro';
import Button from '../components/ui/Button.astro';
import SocialIcon from '../components/ui/SocialIcon.astro';
import VidigalPanel from '../components/ui/VidigalPanel.astro';
import { author } from '../data/author';
import StataPlan from '../components/ui/StataPlan.astro';
import ProjectLinks from '../components/ui/ProjectLinks.astro';
import { practiceUrl } from '../data/cards';
import { homeCards, spotlights } from '../data/home';
import { talk } from '../data/talk';

const mailto = `mailto:${author.email}`;
const spot = Object.fromEntries(spotlights.map((s) => [s.id, s]));

---

<PageLayout ogType="profile">
  <!-- Hero: words only (owner, 2026-10-28); the research artifact follows below -->
  <section id="home" class="hero-section">
    <div class="hero-grid">
    <div class="hero-type">
      <p class="hero-kicker" data-reveal style="--reveal-d: 0;">{author.name}</p>
      <h1
        class="hero-name"
        data-decompose
        data-reveal
        style="--reveal-d: 0;"
      >
        {author.headline}
      </h1>
      <p class="hero-positioning" data-reveal style="--reveal-d: 1;">
        {author.subtitle}
      </p>
      <p class="hero-lines" data-reveal style="--reveal-d: 1;">
        {author.heroLines.map((l, i) => <span class={i === 0 ? 'hero-now' : undefined}>{l}</span>)}
      </p>
      {talk && (
        <a href={talk.href} class="talk-band" data-reveal style="--reveal-d: 2;">
          <span class="talk-band-kind">Speaking</span>
          <span>{talk.event}, <span class="talk-band-when">{talk.when}</span></span>
          <span class="talk-band-arrow" aria-hidden="true">&rarr;</span>
        </a>
      )}
      <div class="hero-cta-row" data-reveal style="--reveal-d: 3;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
        <Button href={practiceUrl} variant="secondary">For robot makers</Button>
      </div>
    </div>
    </div>
  </section>

  <!-- Three spotlights. Method and affiliation only: the studies are
       unpublished and multi-author, so no result or finding appears here. -->
  <section id="favela" class="spotlight pt-6">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-4" data-reveal>{spot.favela.label}</h2>
      <h3 class="research-lead-title" data-reveal style="--reveal-d: 1;">{spot.favela.title}</h3>
      <p class="research-lead-body" data-reveal style="--reveal-d: 2;">{spot.favela.lead}</p>
    </div>
    <VidigalPanel revealDelay={3} />
    <ProjectLinks slugs={spot.favela.slugs} />
  </section>

  <section id="robotics" class="spotlight">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-4" data-reveal>{spot.robotics.label}</h2>
      <h3 class="research-lead-title" data-reveal style="--reveal-d: 1;">{spot.robotics.title}</h3>
      <figure class="spotlight-fig" data-reveal style="--reveal-d: 3;">
        <img src={`${base}/projects/autonomous-mobile-robot/hero-poster.jpg`} width="600" height="338" alt="A Segway Loomo robot following a person indoors at EPFL." loading="lazy" decoding="async" />
        <figcaption>Segway Loomo, EPFL VITA Lab · 2022–23</figcaption>
      </figure>
    </div>
    <ProjectLinks slugs={spot.robotics.slugs} />
  </section>

  <section id="legible" class="spotlight">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-4" data-reveal>{spot.legible.label}</h2>
      <h3 class="research-lead-title" data-reveal style="--reveal-d: 1;">{spot.legible.title}</h3>
      <p class="research-lead-body" data-reveal style="--reveal-d: 2;">{spot.legible.lead}</p>
      <figure class="spotlight-fig" data-reveal style="--reveal-d: 3;">
        <p class="spotlight-fig-lead">One example, on a public recording: the robot was in one corridor, and reported, sure to a few centimetres, that it was in another.</p>
        <StataPlan />
        <figcaption>PR2, MIT Stata Center dataset (CC BY 3.0)</figcaption>
      </figure>
    </div>
    <ProjectLinks slugs={spot.legible.slugs} external={{ label: 'theohermann.ch', href: practiceUrl }} />
  </section>

  <!-- More work: one card; the full list lives on /projects/ -->
  <section id="projects" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <h2 class="section-label mb-10" data-reveal>More work</h2>
      <div class="grid grid-cols-1 gap-4">
        {homeCards.map((c) => (
          <a
            href={`${base}${c.href}`}
            id={c.id}
            class="proof-plate work-card"
            data-reveal
            style="--reveal-d: 1;"
          >
            <p class="proof-plate-label">{c.label}</p>
            <p class="proof-plate-title">{c.title}</p>
            <dl class="work-card-hrc">
              <dt>Hidden</dt><dd>{c.hidden}</dd>
              <dt>Revealed</dt><dd>{c.revealed}</dd>
              <dt>Changed</dt><dd>{c.changed}</dd>
            </dl>
            {c.foot && <p class="work-card-foot">{c.foot}</p>}
          </a>
        ))}
      </div>
      <p class="mt-8">
        <a href={`${base}/projects/`} class="text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)]">All work →</a>
      </p>
    </div>
  </section>


  <!-- Biography -->
  <section id="about" class="py-[var(--space-section)]">
    <div class="mx-auto max-w-[var(--max-w-content)] px-6">
      <div class="flex flex-col md:flex-row gap-12 items-start">
      <div class="shrink-0 mx-auto md:mx-0" data-reveal style="--reveal-d: 1;">
        <div class="avatar-mark">
          <canvas
            class="monogram-avatar"
            data-monogram={author.monogram.replace(/[^A-Za-z]/g, '')}
            width="180"
            height="180"
            aria-hidden="true"
          ></canvas>
        </div>
        <div class="mt-4 text-center md:text-left">
          <p class="text-xl font-bold text-text-primary">{author.name}</p>
          <p class="text-sm text-text-muted">{author.role}</p>
        </div>
        <div class="flex gap-3 mt-4 justify-center md:justify-start">
          {author.social.map((s) => (
            <a
              href={s.href}
              {...(s.icon !== 'email' ? { target: '_blank', rel: 'noopener' } : {})}
              class="text-text-muted hover:text-text-secondary transition-colors"
              aria-label={s.label}
              title={s.label}
            >
              <SocialIcon type={s.icon as 'email' | 'github' | 'linkedin' | 'scholar'} />
            </a>
          ))}
        </div>
      </div>
      <div class="flex-1 max-w-prose" data-reveal style="--reveal-d: 2;">
        {author.bio.map((paragraph) => (
          <p class="text-text-secondary leading-relaxed mb-4" set:html={paragraph} />
        ))}
        <p class="mt-2">
          <a href={`${base}/cv/`} class="inline-block py-3 -my-3 text-sm text-[var(--color-link)] hover:text-[var(--color-link-hover)] underline-offset-4 underline decoration-1">Full CV →</a>
        </p>
      </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact-section relative py-[var(--space-section)] overflow-hidden">
    <div class="contact-bg absolute inset-0"></div>
    <div class="relative z-10 mx-auto max-w-[var(--max-w-content)] px-6 text-center">
      <h2 class="text-4xl md:text-5xl font-bold text-accent mb-4" data-reveal>Get in touch.</h2>
      <p class="text-text-secondary mb-10 max-w-lg mx-auto text-lg" data-reveal style="--reveal-d: 1;">
        A project, a collaboration, or a question about the work on this page: write two lines.
      </p>
      <div class="flex justify-center gap-3 sm:gap-5 flex-wrap" data-reveal style="--reveal-d: 2;">
        <Button href={mailto}>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          E-mail
        </Button>
      </div>
      <p class="contact-address" data-reveal style="--reveal-d: 3;">{author.email}</p>
    </div>
  </section>


  <script>
    import { initMonogramAvatar } from '../scripts/monogram-avatar.ts';
    const avatar = document.querySelector('.monogram-avatar') as HTMLCanvasElement | null;
    if (avatar) initMonogramAvatar(avatar);
  </script>
</PageLayout>
