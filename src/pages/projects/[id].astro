---
import { existsSync } from 'node:fs';
import { base } from '../../data/base';
import PageLayout from '../../layouts/PageLayout.astro';
import { getCollection, render } from 'astro:content';
import VidigalAbstract from '../../components/ui/VidigalAbstract.astro';
import Picture from '../../components/ui/Picture.astro';
import { author } from '../../data/author';
import { siteConfig } from '../../data/site';
import TrackFigure from '../../components/ui/TrackFigure.astro';
import FactsStrip from '../../components/ui/FactsStrip.astro';
import ReplayFigure from '../../components/ui/ReplayFigure.astro';
import { trackFigure, fillFacts } from '../../data/figures';
import { stataFacts } from '../../data/stataReplay';
import '../../styles/project-page.css';

export async function getStaticPaths() {
  const all = await getCollection('projects', ({ data }) => !data.draft);
  // the pager walks the same order as the /projects/ grid
  const projects = [
    ...all.filter((p) => p.data.featuredOrder !== undefined).sort((a, b) => a.data.featuredOrder! - b.data.featuredOrder!),
    ...all.filter((p) => p.data.featuredOrder === undefined).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
  ];
  return projects.map((project, i) => ({
    params: { id: project.id },
    props: {
      project,
      prev: projects[i - 1]
        ? { id: projects[i - 1].id, title: projects[i - 1].data.title }
        : null,
      next: projects[i + 1]
        ? { id: projects[i + 1].id, title: projects[i + 1].data.title, label: projects[i + 1].data.label }
        : null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const replay = project.id === 'ros2-localization-triage';
const railSrc = project.data.railImage ?? project.data.image;
const hasRail = replay || project.data.figure === 'tracks' || (!project.data.figure && !!railSrc);
const paperTwin = railSrc ? existsSync(`${process.cwd()}/public${railSrc.replace(/(\.[a-z]+)$/, '-paper$1')}`) : false;
const strip = replay ? stataFacts() : null;
const lead = !!(project.data.figure || project.data.facts);
const facts = project.data.facts ? fillFacts(project.data.facts, trackFigure().stats).filter((f) => f.label !== 'Sequence').slice(0, 3) : null;
const sameLink = project.data.github && project.data.externalLink === project.data.github;
const nextRow = lead && next && existsSync(`${process.cwd()}/public/projects/${next.id}/row.webp`) ? `${base}/projects/${next.id}/row.webp` : null;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: project.data.title,
  description: project.data.summary,
  datePublished: project.data.date.toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
    url: siteConfig.url,
  },
  image: new URL(project.data.image || siteConfig.ogImage, siteConfig.url).href,
  url: new URL(`/projects/${project.id}`, siteConfig.url).href,
  ...(project.data.tags.length > 0 && { keywords: project.data.tags.join(', ') }),
};
---

<PageLayout title={project.data.title} description={project.data.summary} image={project.data.image} ogType="article" articleJsonLd={articleJsonLd}>
  <section class="pj-section py-[var(--space-section)]">
    <div class={`pj${hasRail ? ' pj-split' : ''} mx-auto max-w-[var(--max-w-content)] px-6`} data-prev={prev ? `${base}/projects/${prev.id}/` : undefined} data-next={next ? `${base}/projects/${next.id}/` : undefined}>
      <!-- Header -->
      <div class={`pj-head mb-10${lead ? '' : ' pj-head-plain'}`}>
        <a href={`${base}/projects/`} data-back={project.id} data-home={`${base}/`} class="text-sm text-text-muted hover:text-text-secondary mb-4 inline-block">
          ← Back to projects
        </a>
        <h1 class="text-3xl font-bold text-text-primary mt-2">{project.data.title}</h1>
        {project.data.label && (
          <p class="text-sm text-accent mt-2">{project.data.label}</p>
        )}
        {!lead && project.data.metric && (
          <p class="text-xs text-text-muted mt-2 px-3 py-1 border border-border w-fit">
            {project.data.metric}
          </p>
        )}
        {!lead && project.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {project.data.tags.map((tag: string) => (
              <span class="text-xs px-2 py-0.5 bg-bg-elevated text-text-muted border border-border">
                {tag}
              </span>
            ))}
          </div>
        )}
        {lead && <p class="text-lg text-text-secondary mt-4 max-w-2xl">{project.data.summary}</p>}
      </div>

      {replay ? (
        <>
          <div class="pj-rail pj-rail-panel pj-rail-replay">
            <ReplayFigure />
          </div>
          {strip && <FactsStrip facts={strip} />}
        </>
      ) : project.data.figure === 'tracks' ? (
        <div class="pj-rail pj-rail-panel">
          <TrackFigure />
          {facts && <FactsStrip facts={facts} />}
        </div>
      ) : (
        <>
          {facts && <FactsStrip facts={facts} />}
          {!project.data.figure && railSrc && (
            <div class="pj-rail pj-rail-picture mb-10 overflow-hidden border border-border">
              <Picture
                src={railSrc}
                anim={!project.data.railImage && project.data.cardAnim && (!project.data.cardImage || project.data.cardImage === project.data.image) ? project.data.cardAnim : undefined}
                phone={project.data.imagePhone}
                phoneMax={639}
                alt={project.data.imageAlt ?? project.data.title}
                width={project.data.railImage ? project.data.railImageSize ?? 2000 : project.data.imageWidth ?? 1200}
                height={project.data.railImage ? project.data.railImageSize ?? 2000 : project.data.imageHeight ?? 630}
                plain={project.data.cardImage !== project.data.image && !paperTwin}
                loading="eager"
                fetchpriority="high"
                imgClass="w-full h-auto block"
              />
            </div>
          )}
        </>
      )}

      {project.id === 'urban-morphometrics' && <VidigalAbstract />}

      <!-- Body -->
      <article class="prose max-w-2xl pj-body">
        <Content />
      </article>

      {lead && project.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-10">
          {project.data.tags.map((tag: string) => (
            <span class="text-xs px-2 py-0.5 bg-bg-elevated text-text-muted border border-border">{tag}</span>
          ))}
        </div>
      )}

      <!-- Links -->
      {lead && (project.data.externalLink || project.data.github) && (
        <ul class="entry-rows">
          {project.data.externalLink && !sameLink && (
            <li><a href={project.data.externalLink} target="_blank" rel="noopener">
              <span class="entry-plate entry-plate-out" aria-hidden="true">&nearr;</span>
              <span class="entry-title">{new URL(project.data.externalLink).hostname.replace(/^www\./, '')}</span>
              <span class="entry-meta">Link</span>
              <span class="entry-arrow" aria-hidden="true">&rarr;</span>
            </a></li>
          )}
          {project.data.github && (
            <li><a href={project.data.github} target="_blank" rel="noopener">
              <span class="entry-plate entry-plate-out" aria-hidden="true">&nearr;</span>
              <span class="entry-title">Source code</span>
              <span class="entry-meta">{new URL(project.data.github).hostname}</span>
              <span class="entry-arrow" aria-hidden="true">&rarr;</span>
            </a></li>
          )}
        </ul>
      )}
      {!lead && (project.data.externalLink || project.data.github || project.data.proprietary) && (
        <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
          {project.data.externalLink && (
            <a
              href={project.data.externalLink}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2"
            >
              {new URL(project.data.externalLink).hostname.replace(/^www\./, '')} →
            </a>
          )}
          {project.data.github && (
            <a
              href={project.data.github}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2"
            >
              Source code →
            </a>
          )}
          {project.data.proprietary && (
            <span
              class="inline-flex items-center gap-2 text-xs text-text-muted px-2.5 py-1 border border-border"
              title="Source code remains proprietary — no public repository."
            >
              Code: proprietary
            </span>
          )}
        </div>
      )}

      {lead && next && (
        <ul class="entry-rows mt-10">
          <li><a href={`${base}/projects/${next.id}/`}>
            {nextRow
              ? <span class="entry-plate"><img src={nextRow} alt="" width="176" height="132" loading="lazy" decoding="async" /></span>
              : <span class="entry-plate entry-plate-out" aria-hidden="true">&rarr;</span>}
            <span class="entry-title">{next.title}</span>
            <span class="entry-meta">{next.label ?? 'Next project'}</span>
            <span class="entry-arrow" aria-hidden="true">&rarr;</span>
          </a></li>
        </ul>
      )}

      <!-- Prev / next pager -->
      {!lead && (prev || next) && (
        <nav class="pager mt-16 pt-8 border-t border-border grid grid-cols-2 gap-3 sm:gap-4" aria-label="More projects">
          {prev ? (
            <a href={`${base}/projects/${prev.id}/`} class="pager-cell group/p">
              <span class="pager-eyebrow">&larr;&nbsp;&nbsp;Previous</span>
              <span class="pager-title">{prev.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a href={`${base}/projects/${next.id}/`} class="pager-cell pager-cell-end group/p">
              <span class="pager-eyebrow">Next&nbsp;&nbsp;&rarr;</span>
              <span class="pager-title">{next.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      )}
    </div>
  </section>
</PageLayout>

<style>
  .pager-cell {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--color-border);
    background: var(--color-bg-secondary);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .pager-cell-end {
    align-items: flex-end;
    text-align: right;
  }

  .pager-cell:hover {
    border-color: var(--color-border-hover);
    box-shadow: 0 0 0 1px var(--color-accent-soft), 0 0 22px rgba(59, 130, 246, 0.12);
    transform: translateY(-2px);
  }

  .pager-eyebrow {
    font-family: var(--font-display);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .pager-title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .group\/p:hover .pager-title {
    color: var(--color-text-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .pager-cell { transition: none; }
    .pager-cell:hover { transform: none; }
  }
</style>

<script>
  import '../../scripts/project-rows.ts';
  import '../../scripts/project-swipe.ts';
  const back = document.querySelector('a[data-back]') as HTMLAnchorElement | null;
  if (back) {
    try {
      const from = JSON.parse(sessionStorage.getItem('back-from') ?? 'null');
      if (from && from.slug === back.dataset.back && /^[a-z]+$/.test(from.id)) {
        back.href = `${back.dataset.home}#${from.id}`;
        back.textContent = '← Back';
      }
    } catch {}
  }
</script>
