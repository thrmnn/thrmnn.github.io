---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { base } from '../../../data/base';

const data = 'vidigal-rooftops';
const meta = JSON.parse(readFileSync(join(process.cwd(), `public/data/${data}.json`), 'utf8')) as { stride: number };
const line = 'Vidigal, Rio de Janeiro · terrain and building footprints';
---

<BaseLayout title="Vidigal, explore" description={line}>
  <main class="explore" id="main-content">
    <canvas
      class="explore-canvas"
      data-rooftops={`${base}/data/${data}.bin`}
      data-stride={meta.stride}
      data-explore="1"
      data-emphasis="1"
      tabindex="0"
      aria-label="Point cloud of Vidigal, Rio de Janeiro. Drag or use the arrow keys to turn it, scroll, pinch or use plus and minus to zoom, 0 to reset."
    ></canvas>
    <header class="bar">
      <a class="btn close" href={`${base}/projects/`} aria-label="Close and return to projects">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 2l10 10M12 2L2 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
        <span>Close</span>
      </a>
      <p class="line">{line}</p>
      <button class="btn" type="button" id="reset">Reset view</button>
    </header>
  </main>
</BaseLayout>

<style is:global>
  html:has(.explore), body:has(.explore) { background: #0e1016; overflow: hidden; overscroll-behavior: none; }
</style>

<style>
  .explore { position: fixed; inset: 0; background: #0e1016; color: #e6e8ee; }
  .explore-canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; outline: none; }
  .explore-canvas:active { cursor: grabbing; }
  .explore-canvas:focus-visible { outline: 2px solid #568cf6; outline-offset: -4px; }
  .bar {
    position: absolute; top: 0; left: 0; right: 0; z-index: 2;
    display: flex; align-items: center; gap: 12px;
    padding: max(12px, env(safe-area-inset-top)) 16px 12px;
    pointer-events: none;
  }
  .bar > * { pointer-events: auto; }
  .line { flex: 1; margin: 0; font-size: 0.78rem; color: #9aa0ad; text-align: center; min-width: 0; }
  .btn {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px;
    font: inherit; font-size: 0.85rem; color: #e6e8ee; background: rgba(14,16,22,0.7);
    border: 1px solid rgba(255,255,255,0.18); border-radius: 999px; cursor: pointer; text-decoration: none;
  }
  .btn:hover { border-color: rgba(255,255,255,0.4); }
  .btn:focus-visible { outline: 2px solid #568cf6; outline-offset: 2px; }
  @media (max-width: 560px) {
    .bar { flex-wrap: wrap; }
    .line { order: 3; flex-basis: 100%; text-align: left; }
    .bar #reset { margin-left: auto; }
  }
</style>

<script>
  import { initVidigalPanel } from '../../../scripts/vidigal-panel.ts';

  const canvas = document.querySelector<HTMLCanvasElement>('.explore-canvas')!;
  initVidigalPanel(canvas).then((api) => {
    document.getElementById('reset')?.addEventListener('click', () => (api as { reset: () => void } | undefined)?.reset());
    canvas.focus({ preventScroll: true });
  });

  const closeHref = (document.querySelector('a.close') as HTMLAnchorElement).href;
  const leave = () => {
    let same = false;
    try { same = new URL(document.referrer).origin === location.origin; } catch {}
    if (same && history.length > 1) history.back();
    else location.href = closeHref;
  };
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') leave();
  });
  document.querySelector('a.close')!.addEventListener('click', (e) => {
    e.preventDefault();
    leave();
  });
</script>
